<Project Sdk="Microsoft.NET.Sdk">

  <!-- ARM 2 of the sstring twin probe: a [GoRecv] method taking sstring, compiled with the go2cs-gen
       analyzer referenced exactly as the converted corpus references it (fmt.csproj's form). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8981</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="go.builtin" Static="True" />
    <Using Include="System" />
    <Using Include="System.Object" Alias="any" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/gen/go2cs-gen/go2cs-gen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="All" />
    <ProjectReference Include="../../../src/core/golib/golib.csproj" />
  </ItemGroup>

</Project>

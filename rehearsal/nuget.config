<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="int" value="https://apiint.nugettest.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="int"><package pattern="nugetgo.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <LangVersion Condition="'$(LangVersion)'==''">14</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>go2cs.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.5.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.1.0" />
    <PackageReference Include="MSTest.TestFramework" Version="2.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced as a plain library, NOT as an analyzer: these tests exercise the
         generator's identifier helpers directly. -->
    <ProjectReference Include="..\..\gen\go2cs-gen\go2cs-gen.csproj" />
    <!-- The real golib: GoTypeDefinitionCommentTests compiles converted declarations plus the
         generator's output against it, so "a deleted definition comment fails the build" is read
         from the compiler's own verdict, not inferred from the generated text. Aliased: golib and
         go2cs-gen both declare go2cs.Symbols, so an unaliased reference makes every test that uses it
         ambiguous (CS0433). -->
    <ProjectReference Include="..\..\core\golib\golib.csproj" Aliases="golib" />
  </ItemGroup>

</Project>

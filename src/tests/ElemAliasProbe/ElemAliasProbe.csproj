<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Isolation probe for the golib element-aliasing lost-update defect rooted 2026-08-30
    (see docs/phase4/INVESTIGATION-element-aliasing.md).

    Deliberately NOT registered in either .slnx and enumerated by NO gate: it is a diagnostic
    instrument, not a corpus member. It references the BUILT golib / sync.atomic assemblies rather
    than taking project references, so building it never perturbs the corpus's own build state.
    Build those two packages first, then:

        dotnet run (project src/tests/ElemAliasProbe, config Release), passing an arm name.

    Arms: all, arm0 .. arm9, arm1r, arm2r
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <AssemblyName>ElemAliasProbe</AssemblyName>
    <RootNamespace>ElemAliasProbe</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8981;CS0649;CS0169</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <GolibBin>$(MSBuildThisFileDirectory)..\..\core\golib\bin\$(Configuration)\$(TargetFramework)\</GolibBin>
    <AtomicBin>$(MSBuildThisFileDirectory)..\..\core\sync\atomic\bin\$(Configuration)\$(TargetFramework)\</AtomicBin>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="golib">
      <HintPath>$(GolibBin)golib.dll</HintPath>
    </Reference>
    <Reference Include="sync.atomic">
      <HintPath>$(AtomicBin)sync.atomic.dll</HintPath>
    </Reference>
    <Reference Include="unsafe">
      <HintPath>$(AtomicBin)unsafe.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

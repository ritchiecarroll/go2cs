<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone runner for the go2cs performance comparison suite.

    Deliberately dependency-free: it orchestrates external processes (go2cs.exe, go build,
    dotnet build/publish, the benchmark programs) and reduces their timings into a markdown
    report. It references NO project (not even golib) and is NOT hosted in testhost.exe, for
    the same isolation reasons as the sibling BehavioralRunner.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)'==''">14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PerformanceRunner</AssemblyName>
    <RootNamespace>PerformanceRunner</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Not part of any solution build; invoked directly via run-performance.ps1 / dotnet run. -->
  </PropertyGroup>

  <!--
    The converter-staleness predicate, shared by this runner, BehavioralRunner and
    BehavioralTestBase. Linked rather than referenced: this project takes no assembly dependency, and
    all three predicates must answer the same question the same way or false-green route #5 reopens
    in whichever one drifts.
  -->
  <ItemGroup>
    <Compile Include="../../ConverterBuildInputs.cs" Link="ConverterBuildInputs.cs" />
  </ItemGroup>

</Project>

<Project>

  <!-- MSBuild stops at the first Directory.Build.props walking up, so the repository-wide
       settings (src/Directory.Build.props, which owns $(TargetFramework)) must be imported
       explicitly or this file silently shadows them for everything beneath it. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!-- Shared settings for the performance benchmark projects. The go2cs converter regenerates each
       benchmark's .csproj on every transpile, so settings that must survive a re-transpile live here
       (this file is never converter-owned). Native AOT publish support is in Directory.Build.targets. -->

  <PropertyGroup>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <!-- Pins $(go2csPath) to the repository's src root, as src/core's and src/tests/Behavioral's
       Directory.Build.props do: a converted benchmark's .csproj defaults it to $(USERPROFILE)/go2cs/ (the
       deployed tree) under any configuration but Debug, so a Release build of go2cs.slnx bound these
       members to whatever that tree held. An explicit -p:go2csPath or environment variable still wins. -->
  <PropertyGroup Condition="'$(go2csPath)' == ''">
    <go2csPath>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))))</go2csPath>
  </PropertyGroup>

  <!-- Native AOT publishes (PerfAot gate, see Directory.Build.targets) get their own intermediate
       tree: a RID-specific self-contained publish and a plain framework-dependent build sharing one
       obj\ cross-pollute (the next JIT build inherits self-contained restore assets and produces an
       exe that fails with "You must install or update .NET"). -->
  <PropertyGroup Condition="'$(PerfAot)'=='true'">
    <BaseIntermediateOutputPath>obj\aot\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\aot-build\</BaseOutputPath>
  </PropertyGroup>

</Project>

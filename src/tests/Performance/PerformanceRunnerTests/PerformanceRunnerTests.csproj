<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Guards for the performance runner's release-leg decisions (docs/PLAN-perf-rebaseline.md, S0): what a release leg
    refuses before anything is timed; and for when it may reuse a completed AOT publish. The decisions are pure functions in the runner's ReleaseLegs.cs, LINKED here
    rather than referenced, so the runner stays dependency-free (as ConverterBuildInputs.cs is linked into it).
  -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion Condition="'$(LangVersion)'==''">14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PerformanceRunnerTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.5.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.1.0" />
    <PackageReference Include="MSTest.TestFramework" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../PerformanceRunner/ReleaseLegs.cs" Link="ReleaseLegs.cs" />
    <Compile Include="../PerformanceRunner/AotPublishReuse.cs" Link="AotPublishReuse.cs" />
  </ItemGroup>

</Project>

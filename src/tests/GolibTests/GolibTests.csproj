<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.5.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.1.0" />
    <PackageReference Include="MSTest.TestFramework" Version="2.1.0" />
    <PackageReference Include="coverlet.collector" Version="1.2.0" />
    <!-- Roslyn: the B′-S0 selection probes compile snippets against the REAL golib and
         sync/atomic assemblies and read the compiler's own verdict (diagnostics + SemanticModel),
         which is the only way to prove a "cannot select" claim by construction. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
  </ItemGroup>

  <!-- The spawn-seam gate file drives linux-flavor-only syscall surface (Wait4, the unix
       ProcAttr); under any other $(GoTargetOS) it is excluded from compilation entirely,
       mirroring the L3 corpus's own per-GOOS item mechanism.

       THIS EXCLUSION IS THE ONLY PROTECTION, and the runtime host checks inside these files are NOT
       a second layer — measured 2026-08-31, both configurations:

         * default target: the files are excluded here, so a filtered run reports "No test matches"
           and exit 0. Correct, but it means the in-file host check never executes.
         * $(GoTargetOS)=linux on a WINDOWS host: the files ARE compiled, and the linux syscall
           assembly's MODULE INITIALIZER throws `DllNotFoundException: libc` out of
           syscall_package.init() (rlimit.cs) before any [TestMethod] body runs. MSTest attributes
           that to the test, so it reads as a test failure rather than the configuration error it is.

       A module initializer precedes every test body, so no per-test `Assert.Inconclusive` can reach
       it — the host checks in those files are dead code in both directions, and an assembly-level
       check would lose the same race the moment it touched the flavor's types. The residual case is
       therefore a DELIBERATE cross-flavor invocation (asking for one OS's flavor on another OS's
       host), which is a configuration error rather than something a gate tier produces; building a
       runner layer to guard deliberate misuse would be speculative machinery. Named here rather than
       defended against — ruled 2026-08-31. If you meet that stack trace, the target and the host
       disagree; nothing is wrong with the code under test. -->
  <ItemGroup Condition="'$(GoTargetOS)' != 'linux'">
    <Compile Remove="LinuxSpawnSeamTests.cs" />
    <Compile Remove="LinuxSignalMaskTests.cs" />
    <Compile Remove="LinuxSyscallClockTests.cs" />
    <Compile Remove="LibcCallDispatchTests.cs" />
    <Compile Remove="DarwinSigmaskContractTests.cs" />
    <Compile Remove="DarwinSigactionContractTests.cs" />

    <!-- A per-GOOS hand-own's Go-prefixed test helpers exist only under that flavour, so the GolibTests
         classes that drive them are linux-only FILES by construction. These two reference
         GoBootstrapConstants/GoParseHugePageSize (runtime/linux/os_linux_impl.cs) and
         GoUsleepProbe/GoSysMmapProbe/GoSysMmapErrnoProbe (runtime/linux/mem_linux_impl.cs); compiled on
         the windows flavour they are 22 strict CS0103 and they took train 29 red at the union gate. -->
    <Compile Remove="RuntimeMemoryFamilyTests.cs" />
    <Compile Remove="RuntimeBootstrapConstantsTests.cs" />
  </ItemGroup>

  <!-- The netapi32 ptrout gate is the mirror image: it drives windows-flavor-only syscall surface
       (NetUserGetInfo, NetApiBufferFree), so under any other $(GoTargetOS) it is excluded from
       compilation entirely. The test ALSO gates on the running HOST at runtime, which is the
       load-bearing half: a flavor compiled for one OS and run on another sails past a
       declaration-only check and then dies in a module initializer, which reads like a regression
       in whatever is under test rather than as NOT MEASURED.

       The empty case is why this tests '' explicitly rather than mirroring the linux gate's shape:
       $(GoTargetOS) is UNSET in this project (the corpus defaults it per-package, not in a shared
       props file), and unset means the default windows corpus. A bare "!= 'windows'" therefore
       removes this file on every ordinary run, and a filtered `dotnet test` answers "No test matches"
       with EXIT 0 — an instrument that measures nothing and reports success. Measured, not
       assumed: `-getProperty:GoTargetOS` returns "" here. -->
  <ItemGroup Condition="'$(GoTargetOS)' != '' and '$(GoTargetOS)' != 'windows'">
    <Compile Remove="WindowsNetUserInfoTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="go.builtin" Static="True" />
    <Using Include="System.Byte" Alias="uint8" />
    <Using Include="System.UInt16" Alias="uint16" />
    <Using Include="System.UInt32" Alias="uint32" />
    <Using Include="System.UInt64" Alias="uint64" />
    <Using Include="System.SByte" Alias="int8" />
    <Using Include="System.Int16" Alias="int16" />
    <Using Include="System.Int32" Alias="int32" />
    <Using Include="System.Int64" Alias="int64" />
    <Using Include="System.Single" Alias="float32" />
    <Using Include="System.Double" Alias="float64" />
    <Using Include="System.Numerics.Complex" Alias="complex128" />
    <Using Include="System.Int32" Alias="rune" />

    <ProjectReference Include="..\..\core\golib\golib.csproj" />
    <ProjectReference Include="..\..\core\sync\atomic\sync.atomic.csproj" />

    <!-- The Linux spawn-seam gates (LinuxSpawnSeamTests) drive syscall.StartProcess/Wait4 —
         the converted surface over the posix_spawn hand-own, per the exec-wall design's §5.1
         and OQ-2 measured gates. The gate FILE compiles only under the linux corpus flavor
         (Wait4 and the unix ProcAttr surface do not exist in the windows flavor), the same
         $(GoTargetOS) mechanism the L3 corpus itself uses; the reference stays unconditional
         so the windows build proves the project graph. -->
    <ProjectReference Include="..\..\core\syscall\syscall.csproj" />

    <!-- WindowsNetUserInfoTests also drives internal/syscall/windows' NetUserGetLocalGroups, the
         second netapi32 member of the ptrout class. Unconditional for the same reason as syscall
         above: the package is windows-EXCLUSIVE (every source file sits in its L3 windows/ GOOS
         folder), so under any other $(GoTargetOS) its csproj compiles nothing and yields an empty
         assembly — the crypto/x509/internal/macos shape — and referencing it cannot break a
         cross-target build. The gate FILE is what is conditional. -->
    <ProjectReference Include="..\..\core\internal\syscall\windows\internal.syscall.windows.csproj" />

    <!-- Sha3ReinterpretVectorTests: the ONLY guard the hand-owned sha3 xor.cs has (no _test.go in
         GOROOT, not reachable from a behavioral test). Binding a converted package from an MSTest
         tier follows GenericTests, which references core/sort. -->
    <ProjectReference Include="..\..\core\vendor\golang.org\x\crypto\sha3\vendor.golang.org.x.crypto.sha3.csproj" />

    <!-- TestExecutionOutputCapTests: same reason, one tier up. The hand-owned Phase-4 test HOST has
         no _test.go anywhere and no behavioral test can reach it — a converted suite exercises it
         only by being run, which is exactly the path a robustness guard must not depend on. -->
    <ProjectReference Include="..\..\core\testing\testing.csproj" />

    <!-- GcMeasurementSurfaceProbes: the ReadMemStats measurement surface itself
         (docs/phase4/DESIGN-readmemstats-surface.md S1). The allocation guard has to call the real
         runtime.ReadMemStats, not a model of it. -->
    <ProjectReference Include="..\..\core\runtime\runtime.csproj" />

    <!-- GcPauseHistorySurfaceTests: the OTHER half of the same surface (S2/S3). The design's central
         claim is that runtime.ReadMemStats and runtime/debug.ReadGCStats read ONE snapshot, so the
         guard has to hold BOTH of them against each other — which needs both packages bound. -->
    <ProjectReference Include="..\..\core\runtime\debug\runtime.debug.csproj" />

    <!-- MulUnbalancedDiscriminatorTests: the §5.4 discriminator drives math/big's nat.mul through
         Int.SetBits/Int.Mul. Same precedent as sha3 above — an MSTest tier binding a converted
         package to reach a measurement no other harness can take. -->
    <ProjectReference Include="..\..\core\math\big\math.big.csproj" />

    <!-- UnsafePointerRetentionTests: the bare-unsafe.Pointer atomic primitives (StorepNoWB/Loadp,
         the I5 ruling) driven through the mint the converter emits for `unsafe.Pointer(&x)`. Same
         MSTest-tier-binds-a-converted-package precedent as math/big above; the *unsafe.Pointer
         siblings are correct by signature and need no guard here. -->
    <ProjectReference Include="..\..\core\internal\runtime\atomic\internal.runtime.atomic.csproj" />

    <!-- HostTestMainParseOrderTests: Go's m.Run parses only `if !flag.Parsed()` (testing.go:1944),
         so a TestMain is entitled to install flag.Usage BEFORE any parse — crypto/tls's bogo
         os.Exit(89) override is exactly that. Proving the host stays out of the way needs the real
         converted flag package, because "has a parse happened yet" is only observable there. -->
    <ProjectReference Include="..\..\core\flag\flag.csproj" />

    <!-- ValueAdapterFormatTests: the TestRegisterErr chip (two golib defects: an IValueAdapter
         shell's own type/identity leaking into %#v instead of the wrapped value's). Proving the
         fix needs the REAL reflect.ValueOf → fmt.Sprintf bridge, the same MSTest-tier-binds-a-
         converted-package precedent as sha3/math.big/flag above. -->
    <ProjectReference Include="..\..\core\reflect\reflect.csproj" />
    <ProjectReference Include="..\..\core\fmt\fmt.csproj" />

    <!-- AliasOverlapTests: crypto/internal/alias is the corpus's memory-ALIASING predicate, and it
         is emitted as four `(uintptr)Ꮡ(…)` address takes over MANAGED storage. Its banked row is a
         single verdict, so the semantic contract is guarded nowhere else, and the guard has to drive
         the REAL converted predicate rather than a model of it — the same
         MSTest-tier-binds-a-converted-package precedent as sha3/math.big/flag above. -->
    <ProjectReference Include="..\..\core\crypto\internal\alias\crypto.internal.alias.csproj" />
    <!-- AliasOverlapRaceTests (vendored twin): vendor/golang.org/x/crypto/internal/alias is the purego copy
         of the same predicate, reached by chacha20 and chacha20poly1305 through InexactOverlap. -->
    <ProjectReference Include="..\..\core\vendor\golang.org\x\crypto\internal\alias\vendor.golang.org.x.crypto.internal.alias.csproj" />
    <!-- AliasOverlapRaceTests: the GCM Open shape that killed net/http, driven through the REAL converted
         crypto/aes + crypto/cipher (counterCrypt -> aes Encrypt -> alias.InexactOverlap). -->
    <ProjectReference Include="..\..\core\crypto\aes\crypto.aes.csproj" />
    <ProjectReference Include="..\..\core\crypto\cipher\crypto.cipher.csproj" />
  </ItemGroup>

</Project>

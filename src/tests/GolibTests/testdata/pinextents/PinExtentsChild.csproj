<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pin-extent index's child process (docs/phase4/DESIGN-cgo-pin-extents.md, R5 and R6): golib and unsafe, and no
       cgo package. Built Release and run by GolibTests' PinExtentsChildTests; never part of a solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>
    <AssemblyName>PinExtentsChild</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion Condition="'$(LangVersion)'==''">14</LangVersion>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OutDir)'=='' AND '$(BaseOutputPath)'==''">
    <OutDir>bin/$(Configuration)/$(TargetFramework)/</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\core\golib\golib.csproj" />
    <ProjectReference Include="..\..\..\..\core\unsafe\unsafe.csproj" />
  </ItemGroup>

</Project>

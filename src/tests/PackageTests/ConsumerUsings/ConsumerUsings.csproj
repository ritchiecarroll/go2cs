<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumer fixture for go.lib's consumer usings (src/core/golib/buildTransitive/go.lib.targets).
       Driven by test-consumer-usings.ps1, which restores it from a chosen feed into a fresh package
       cache; it is not a solution member and is never built by the corpus. Program.cs declares NO
       using for golib: the build compiles only if the package supplies them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="go.lib" Version="$(GoPackageVersion)" />
  </ItemGroup>

  <!-- Pre-pack only: point GoLibTargets at the working-tree targets file to exercise it against an
       already-published package set. A packed go.lib brings the same file through buildTransitive. -->
  <Import Project="$(GoLibTargets)" Condition="'$(GoLibTargets)' != ''" />
</Project>

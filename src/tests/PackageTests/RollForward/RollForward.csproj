<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumer fixture for go.lib's roll-forward default (src/core/golib/buildTransitive/go.lib.targets, THE
       ROLL-FORWARD). Driven by test-roll-forward.ps1, which restores it from a chosen feed into a fresh package
       cache and reads the runtimeconfig.json each arm writes; with -DotnetRoot it also RUNS the program on a .NET
       that has no 10.0 runtime. It is not a solution member and is never built by the corpus. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- A RollForward the PROJECT sets (the USER WINS and CONTROL arms). It must be assigned here, in the project body:
       a -p:RollForward on the command line is a GLOBAL property, which no imported file can override whatever its
       condition says, so an arm that passed it that way could not fail on the clause it tests. -->
  <PropertyGroup Condition="'$(FixtureRollForward)' != ''">
    <RollForward>$(FixtureRollForward)</RollForward>
  </PropertyGroup>

  <!-- The TEST PROJECT arm, in the shape of a converted test host (src/go2cs/test-csproj-template.xml): a test
       project that declares itself an executable, as that template does with OutputType Exe. -->
  <PropertyGroup Condition="'$(FixtureTestProject)' == 'true'">
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="go.lib" Version="$(GoPackageVersion)" />
  </ItemGroup>

  <!-- Pre-pack only: point GoLibTargets at the working-tree targets file to exercise it against an
       already-published package set. A packed go.lib brings the same file through buildTransitive. -->
  <Import Project="$(GoLibTargets)" Condition="'$(GoLibTargets)' != ''" />
</Project>

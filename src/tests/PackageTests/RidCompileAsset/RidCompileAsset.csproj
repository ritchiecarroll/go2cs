<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumer fixture for go.lib's RID-selected compile asset (src/core/golib/buildTransitive/go.lib.targets).
       Driven by test-rid-compile-asset.ps1, which restores it from a chosen feed into a fresh package cache;
       it is not a solution member and is never built by the corpus. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The fixture touches a type only ONE flavour of go.syscall defines, chosen by the platform the
         build compiles for; the constant names that platform so Program.cs picks the right type. -->
    <_RidCompileAssetRid>$(RuntimeIdentifier)</_RidCompileAssetRid>
    <_RidCompileAssetRid Condition="'$(_RidCompileAssetRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_RidCompileAssetRid>
    <DefineConstants Condition="$(_RidCompileAssetRid.StartsWith('linux'))">$(DefineConstants);GO_FLAVOUR_LINUX</DefineConstants>
    <DefineConstants Condition="$(_RidCompileAssetRid.StartsWith('win'))">$(DefineConstants);GO_FLAVOUR_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="go.syscall" Version="$(GoPackageVersion)" />
  </ItemGroup>

  <!-- Pre-pack only: point GoLibTargets at the working-tree targets file to exercise it against an
       already-published package set. A packed go.lib brings the same file through buildTransitive. -->
  <Import Project="$(GoLibTargets)" Condition="'$(GoLibTargets)' != ''" />

  <Target Name="ReportSyscallReference" AfterTargets="ResolveAssemblyReferences">
    <Message Importance="high" Text="RID-COMPILE-ASSET syscall reference: %(ReferencePath.Identity)" Condition="'%(ReferencePath.Filename)' == 'syscall'" />
  </Target>
</Project>

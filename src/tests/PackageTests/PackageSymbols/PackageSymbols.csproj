<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumer fixture for the go.* packages' own symbol files. Driven by test-package-symbols.ps1, which restores it
       from a chosen feed into a fresh package cache; it is not a solution member and is never built by the corpus.
       The frame it prints lives in go.sort, so its file:line can only come from the .pdb the go.sort PACKAGE ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="go.lib" Version="$(GoPackageVersion)" />
    <PackageReference Include="go.runtime" Version="$(GoPackageVersion)" />
    <PackageReference Include="go.sort" Version="$(GoPackageVersion)" />
  </ItemGroup>
</Project>

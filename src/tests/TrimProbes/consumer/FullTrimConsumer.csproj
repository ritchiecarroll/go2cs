<Project Sdk="Microsoft.NET.Sdk">
  <!-- G's full-trim scout (2026-10-08): PackageSymbols' Program.cs over PROJECT references to master's golib, runtime and
       sort, so the publish measures master's assemblies and imports none of go.lib's packed defaults (TrimMode=partial). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <!-- The arm is chosen by FtArm, set HERE and not as global properties: a global PublishTrimmed/PublishAot reaches the
       referenced netstandard2.0 generator project and fails it (NETSDK1124). -->
  <PropertyGroup Condition="'$(FtArm)'=='N'">
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FtArm)'=='F'">
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FtArm)'=='P'">
    <PublishAot>true</PublishAot>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <!-- D: the template DEFAULT publish (ILLink partial trim, ReadyToRun, no AOT), COORD gate 2026-10-09. -->
  <PropertyGroup Condition="'$(FtArm)'=='D'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FtArm)'!=''">
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(go2csPath)core/golib/golib.csproj" />
    <ProjectReference Include="$(go2csPath)core/runtime/runtime.csproj" />
    <ProjectReference Include="$(go2csPath)core/sort/sort.csproj" />
  </ItemGroup>
</Project>

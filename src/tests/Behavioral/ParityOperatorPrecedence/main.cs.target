internal static uint32 le32(slice<byte> b) {
    return (uint32)((uint32)((uint32)((uint32)b[0] | ((uint32)b[1] << (int)(8))) | ((uint32)b[2] << (int)(16))) | ((uint32)b[3] << (int)(24)));
}

internal static uint64 le64(slice<byte> b) {
    return (uint64)((uint64)le32(b) | ((uint64)le32(b[4..]) << (int)(32)));
}

// Hoisted @string literals (single allocation; Go keeps these in RODATA)
private static readonly object widthˢ = (@string)"width"u8;
private static readonly object widthVarˢ = (@string)"width-var"u8;


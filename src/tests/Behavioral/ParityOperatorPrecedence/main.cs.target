internal static void tableInt(nint a, nint b, nint c, nint d, nuint k) {
    fmt.Println("int 1", a + b + c);
    fmt.Println("int 2", a + b - c);
    fmt.Println("int 3", a + b * c);
    fmt.Println("int 4", a + rem(b, c));

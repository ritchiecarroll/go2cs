    fmt.Println("int 97", a.Rsh((int64)(b)) ^ c);
    fmt.Println("int 98", a.Rsh((int64)(b)) & ~c);
    fmt.Println("int 99", (a.Rsh((int64)(b))).Lsh((int64)(c)));
    fmt.Println("int 100", (a.Rsh((int64)(b))).Rsh((int64)(c)));
    fmt.Println("int 101", a + b == d, d == a + b, a + b < d, a + b != c + b);
    fmt.Println("int 102", (a & b) == 0 || a + b > c, (a | c) != 0 && a + c <= d);
    fmt.Println("int 103", a - b == d, d == a - b, a - b < d, a - b != c - b);
    fmt.Println("int 104", (a & b) == 0 || a - b > c, (a | c) != 0 && a - c <= d);
    fmt.Println("int 105", a * b == d, d == a * b, a * b < d, a * b != c * b);
    fmt.Println("int 106", (a & b) == 0 || a * b > c, (a | c) != 0 && a * c <= d);
    fmt.Println("int 107", rem(a, b) == d, d == rem(a, b), rem(a, b) < d, rem(a, b) != rem(c, b));
    fmt.Println("int 108", (a & b) == 0 || rem(a, b) > c, (a | c) != 0 && rem(a, c) <= d);
    fmt.Println("int 109", (a & b) == d, d == (a & b), (a & b) < d, (a & b) != (c & b));
    fmt.Println("int 110", (a & b) == 0 || (a & b) > c, (a | c) != 0 && (a & c) <= d);
    fmt.Println("int 111", (a | b) == d, d == (a | b), (a | b) < d, (a | b) != (c | b));
    fmt.Println("int 112", (a & b) == 0 || (a | b) > c, (a | c) != 0 && (a | c) <= d);
    fmt.Println("int 113", (a ^ b) == d, d == (a ^ b), (a ^ b) < d, (a ^ b) != (c ^ b));
    fmt.Println("int 114", (a & b) == 0 || (a ^ b) > c, (a | c) != 0 && (a ^ c) <= d);
    fmt.Println("int 115", (a & ~b) == d, d == (a & ~b), (a & ~b) < d, (a & ~b) != (c & ~b));
    fmt.Println("int 116", (a & b) == 0 || (a & ~b) > c, (a | c) != 0 && (a & ~c) <= d);
    fmt.Println("int 117", a.Lsh((int64)(b)) == d, d == a.Lsh((int64)(b)), a.Lsh((int64)(b)) < d, a.Lsh((int64)(b)) != c.Lsh((int64)(b)));
    fmt.Println("int 118", (a & b) == 0 || a.Lsh((int64)(b)) > c, (a | c) != 0 && a.Lsh((int64)(c)) <= d);
    fmt.Println("int 119", a.Rsh((int64)(b)) == d, d == a.Rsh((int64)(b)), a.Rsh((int64)(b)) < d, a.Rsh((int64)(b)) != c.Rsh((int64)(b)));
    fmt.Println("int 120", (a & b) == 0 || a.Rsh((int64)(b)) > c, (a | c) != 0 && a.Rsh((int64)(c)) <= d);
    fmt.Println("int 121", a << 3, a >> 1, a.Lsh(k), a.Rsh(k), a.Lsh(k) + b, b + a.Rsh(k), a << 3 | b << 1 | c);
}

internal static uint32 le32(slice<byte> b) {
    return (uint32)b[0] | (uint32)b[1] << 8 | (uint32)b[2] << 16 | (uint32)b[3] << 24;
}

internal static uint64 le64(slice<byte> b) {
    return (uint64)le32(b) | (uint64)le32(b[4..]) << 32;
}

internal static void widths(uint32 x32, uint64 x64, nint xi) {
    fmt.Println("width", x32 << 31, x32 >> 31, x64 << 63, x64 >> 63, xi << 62, xi >> 62);
    nuint k32 = 32;
    nuint k64 = 64;
    fmt.Println("width-var", x32.Lsh(k32), x32.Rsh(k32), x64.Lsh(k64), x64.Rsh(k64));
}

internal static void Main() {
    tableUint32(29, 5, 3, 7, 3);
    tableUint64(29, 5, 3, 7, 3);
    tableInt(29, 5, 3, 7, 3);
    tableInt(-29, 5, 3, -7, 2);
    var b = slice<byte>([0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88]);
    fmt.Printf("%#x %#x\n"u8, le32(b), le64(b));
    widths(0xFFFFFFFFU, 0xFFFFFFFFFFFFFFFFUL, 3);
}

} // end main_package

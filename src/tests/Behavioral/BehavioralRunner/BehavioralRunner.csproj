<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone runner for the go2cs behavioral suite (Tier 3).

    Deliberately dependency-free: it orchestrates external processes (go2cs.exe, dotnet build,
    go build, the transpiled programs) and compares files. It references NO project (not even
    golib) and is NOT hosted in testhost.exe, so editing/rebuilding it can never collide with a
    lingering test host's lock on its own assembly (the self-lock failure mode that the MSTest
    harness suffers from is structurally absent here).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)'==''">14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BehavioralRunner</AssemblyName>
    <RootNamespace>BehavioralRunner</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Not part of any solution build; invoked directly via run-behavioral.ps1 / dotnet run. -->
  </PropertyGroup>

  <!--
    The converter-staleness predicate, shared by this runner, BehavioralTestBase and
    PerformanceRunner. Linked rather than referenced: this project takes no assembly dependency, and
    all three predicates must answer the same question the same way or false-green route #5 reopens
    in whichever one drifts.
  -->
  <ItemGroup>
    <Compile Include="../../ConverterBuildInputs.cs" Link="ConverterBuildInputs.cs" />
    <Compile Include="../../PlatformExclusive.cs" Link="PlatformExclusive.cs" />
    <Compile Include="../../BehavioralPackages.cs" Link="BehavioralPackages.cs" />
    <Compile Include="../../BestEffortConversion.cs" Link="BestEffortConversion.cs" />
  </ItemGroup>

</Project>

namespace go;

using fmt = fmt_package;

partial class main_package {

internal static @string setFlag(bool @true) {
    if (@true) {
        return "on";
    }
    return "off";
}

internal static void Main() {
    fmt.Println(setFlag(true), setFlag(false));

    nint @false = 7;
    fmt.Println(@false + 1);
}

} // end main_package

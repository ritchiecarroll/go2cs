<Project>
  <!--
    Directory.Build.targets - Gbtc
    Copyright © 2026 The go2cs Authors. All rights reserved.

    Use of this source code is governed by an MIT-style license
    that can be found in the LICENSE file.

    Every in-tree project (src/core, the -tests hosts the converter publishes there, the behavioral programs)
    keeps the dependency symbol files beside a single-file host on EVERY publish, not only on the publish
    that runs the bundler. The definition is golib's own (core/golib/buildTransitive/go.lib.symbols.targets),
    which go.lib.targets gives every NuGet consumer; a project reference to golib never imports
    buildTransitive, so the tree imports the one file here. A Directory.Build.targets nearer a project
    (src/tests/Performance has one) shadows this file, and that runner's Native AOT path is the publish the
    target must not touch anyway.
  -->
  <Import Project="$(MSBuildThisFileDirectory)core/golib/buildTransitive/go.lib.symbols.targets"
          Condition="'$(GoLibSymbolsTargetsImported)' != 'true' and Exists('$(MSBuildThisFileDirectory)core/golib/buildTransitive/go.lib.symbols.targets')" />

  <!--
    Every packed standard-library package (push-nuget.ps1's `dotnet pack` of go2cs-stdlib.slnx) ships its own
    usings in build/<PackageId>.props, written at pack time by golib's go.lib.pack.targets from the package's
    package_info.cs. It recognises a converted project by $(Product) == go2cs, which the converter's csproj
    template sets, and does nothing outside a pack. go.lib.targets imports the same file for a conversion
    packed against the go.* packages; the tree imports it here for the same reason as the symbols targets.
  -->
  <Import Project="$(MSBuildThisFileDirectory)core/golib/buildTransitive/go.lib.pack.targets"
          Condition="'$(GoLibPackTargetsImported)' != 'true' and Exists('$(MSBuildThisFileDirectory)core/golib/buildTransitive/go.lib.pack.targets')" />

  <!--
    M:N SPIKE (R5b, B2). Spike code: it stays on the spike branch and never lands.
    GoTwins=true switches go2cs-gen's TwinGenerator on for a project; GoTwinsGo=false stops a go statement from
    making its function a twin; GoTwinsRefuse names a file of path|line|id rows the generator refuses by. An
    executable built with twins starts at the generated go.GoTwinEntry, which runs main's twin. GoTwinsFor is
    the way to switch twins on from the command line: a list of project names, since a GoTwins given there is a
    global property and would reach every referenced package. GoTwinsIface (hidden or default) picks the
    interface twin shape and GoTwinsIfaceAll=true twins every interface member; from the command line they are
    given as GoTwinsForIface and GoTwinsForIfaceAll, which reach only the projects GoTwinsFor names. GoAotFor
    publishes the named projects with Native AOT: a PublishAot on the command line reaches the netstandard2.0
    generator project and fails it. GoTwinsSiblings (B4) picks how the twin generator sees its siblings' output:
    unset runs them a second time in a nested driver, memo reads what they wrote and nests the late ones, last
    does the twin work under ZTwinGenerator, after every sibling, and runs nothing twice. GoTwinsTiming=true
    adds the generator's stopwatch to its report. Both are read from the environment as well. GoTwinsPairs=false
    (M:N PROTOTYPE, N3) switches off the func-value pairs and the pair test, the A/B control for the D3 core.
  -->
  <PropertyGroup Condition="'$(GoAotFor)' != '' and $([System.String]::Copy(';$(GoAotFor);').Contains(';$(MSBuildProjectName);'))">
    <PublishAot>true</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GoTwinsFor)' != '' and $([System.String]::Copy(';$(GoTwinsFor);').Contains(';$(MSBuildProjectName);'))">
    <GoTwins>true</GoTwins>
    <GoTwinsIface Condition="'$(GoTwinsIface)' == ''">$(GoTwinsForIface)</GoTwinsIface>
    <GoTwinsIfaceAll Condition="'$(GoTwinsIfaceAll)' == ''">$(GoTwinsForIfaceAll)</GoTwinsIfaceAll>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="GoTwins" />
    <CompilerVisibleProperty Include="GoTwinsGo" />
    <CompilerVisibleProperty Include="GoTwinsPairs" />
    <CompilerVisibleProperty Include="GoTwinsIface" />
    <CompilerVisibleProperty Include="GoTwinsIfaceAll" />
    <CompilerVisibleProperty Include="GoTwinsSiblings" />
    <CompilerVisibleProperty Include="GoTwinsTiming" />
  </ItemGroup>
  <ItemGroup Condition="'$(GoTwinsRefuse)' != ''">
    <AdditionalFiles Include="$(GoTwinsRefuse)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(GoTwins)' == 'true' and '$(OutputType)' == 'Exe'">
    <StartupObject>go.GoTwinEntry</StartupObject>
  </PropertyGroup>
</Project>

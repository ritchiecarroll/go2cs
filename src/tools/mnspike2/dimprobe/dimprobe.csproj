<Project Sdk="Microsoft.NET.Sdk">

  <!-- R5b's K2 probe: a hidden async twin added to a public converted interface, with a default body, against
       hand-written C# implementers. Standalone: no golib, no generator. Runs under the JIT and as Native AOT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>

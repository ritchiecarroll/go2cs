<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ildiff: the claim instrument for "IL-identical" emission changes (the parity stage, ruled 2026-10-19).
    It compares every method body of two builds of the same assemblies and names each method whose IL
    differs. See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>

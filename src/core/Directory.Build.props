<Project>

  <!-- MSBuild stops at the first Directory.Build.props walking up, so the repository-wide
       settings (src/Directory.Build.props, which owns $(TargetFramework)) must be imported
       explicitly or this file silently shadows them for everything beneath it. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!--
    Pins $(go2csPath) for every project in the converted standard library (src/core/) to the
    repository's src root — this file's parent directory.

    Why this is needed:
      The shared runtime (core/golib) lives inside this tree, but the source generators
      (gen/go2cs-gen) live under src/, NOT under core/. Each converted .csproj references them
      via $(go2csPath)core/golib/... and $(go2csPath)gen/go2cs-gen/... (an Analyzer reference),
      where $(go2csPath) otherwise defaults to $(SolutionDir) — correct only when the build is
      driven from a solution rooted at src/. Building a package directly (dotnet build
      <pkg>.csproj) has no SolutionDir at all, so the references dangle and the build fails with
      a flood of "type 'slice<>' / 'GoType' could not be found" errors that look like real
      defects but are pure reference-resolution noise.

      Setting go2csPath here (computed relative to this file, so it is machine-independent) makes
      golib and the analyzers always resolve to LIVE SOURCE: a full-stdlib build picks up the
      latest runtime and generator changes with no per-invocation -p:go2csPath flag, and with no
      risk of binding to a stale DLL or NuGet package.

    Notes:
      * An explicit command-line -p:go2csPath=... still wins (a global property overrides
        Directory.Build.props), so existing documented build commands keep working unchanged.
      * This only fixes PATH RESOLUTION — it does not change WHAT is referenced.
  -->
  <PropertyGroup Condition="'$(go2csPath)' == ''">
    <go2csPath>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))))</go2csPath>
  </PropertyGroup>

  <!-- go2cs-gen's escape registry (trim stage 3c-2b(iii)) tells a PER-OS package (an L3 csproj compiling
       $(GoTargetOS)/*.cs) from a platform-neutral one by whether a source file sits in <project>/<GoTargetOS>/. It stamps
       the per-OS assemblies (go2cs.PlatformVariant), and a neutral package never walks their struct fields, so its registry
       is the same in every OS flavor (the 1.24.13 r6 release rehearsal found two neutral packages that were not). The arch
       axis adds two platform folders, <project>/<GoTargetArch>/ and <project>/<GoTargetOS>-<GoTargetArch>/, read the same
       way: a package may carry one of them and no GOOS folder. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="GoTargetOS" />
    <CompilerVisibleProperty Include="GoTargetArch" />
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
  </ItemGroup>

  <!-- Every project of this tree is the standard library. go2cs-gen's InternalPackageAnalyzer (GO2CS0014) reads the
       flag: Go lets only standard-library code import a standard internal or vendored package, and tests that by
       directory (below GOROOT/src) rather than by import path, so the path alone cannot say it. A module named
       `crypto/x` is not the standard library. -->
  <PropertyGroup>
    <GoStandardLibrary>true</GoStandardLibrary>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="GoStandardLibrary" />
  </ItemGroup>

  <!-- Layout L3's universe check, the text renderPlatformUniverseCheck (src/go2cs/platformLayout.go) renders for the
       declared universe; a Go test holds the two equal (TestCorpusBuildFileCarriesTheUniverseCheck). Without it a
       pair the corpus was never laid out for compiles silently SHORT: a windows build at arm64 would take no amd64/
       folder and no windows-arm64/ one. It is a target in a props file because this is the one build file every
       project of the tree already imports: a Directory.Build.targets here would shadow src/Directory.Build.targets. -->
  <!-- The (GOOS, GOARCH) pairs the converted standard library is laid out for (platformUniverse). -->
  <Target Name="GoCheckLayoutTarget" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_GoLayoutOS>$(GoTargetOS)</_GoLayoutOS>
      <_GoLayoutOS Condition="'$(_GoLayoutOS)'==''">windows</_GoLayoutOS>
      <_GoLayoutArch>$(GoTargetArch)</_GoLayoutArch>
      <_GoLayoutArch Condition="'$(_GoLayoutArch)'==''">amd64</_GoLayoutArch>
      <_GoLayoutTarget>$(_GoLayoutOS)/$(_GoLayoutArch)</_GoLayoutTarget>
    </PropertyGroup>
    <Error Condition="'$(_GoLayoutTarget)'!='windows/amd64' And '$(_GoLayoutTarget)'!='linux/amd64' And '$(_GoLayoutTarget)'!='darwin/amd64' And '$(_GoLayoutTarget)'!='linux/arm64'"
           Text="go2cs: $(_GoLayoutTarget) is not a target the converted standard library is laid out for (windows/amd64, linux/amd64, darwin/amd64, linux/arm64); set GoTargetOS and GoTargetArch to one of them." />
  </Target>

  <!-- Shared NuGet version for every converted stdlib package (single source: src/version.props) -->
  <Import Project="$(MSBuildThisFileDirectory)../version.props" />

  <!-- PACK ONLY: each go.* package carries its assemblies' .pdb beside them (lib/, and after push-nuget.ps1's flavour
       merge every runtimes/<rid>/lib/ too), so a NuGet consumer's std frames resolve to their Go file:line (go.lib's
       packed targets copy package symbols into the consumer's output). push-nuget.ps1 sets GoPackSymbols=true on
       `dotnet pack` alone; no build reads it. APPENDED here, never passed as a -p: global of the property itself: the
       SDK's pack targets prepend their own defaults (.dll; .exe; ...) to this value, and a global would replace it. -->
  <PropertyGroup Condition="'$(GoPackSymbols)' == 'true'">
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

</Project>

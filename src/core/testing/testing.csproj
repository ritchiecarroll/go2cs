<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>
    <RootNamespace>go</RootNamespace>
    <AssemblyName>testing_package</AssemblyName>
    <Product>go2cs</Product>
    <Authors>$(Product) Authors</Authors>
    <Company>The $(Authors)</Company>
    <Copyright>Copyright © 2018-2026 $(Company)</Copyright>
    <RepositoryUrl>https://github.com/ritchiecarroll/go2cs</RepositoryUrl>
    <!-- Hand-owned, but Go-SHAPED: this host declares the same lower-cased type names, Go zero
         values and nil-able references the converted corpus does, so it carries the same suppression
         policy as csproj-template.xml rather than a list of its own. -->
    <Nullable>annotations</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0162;CS0164;CS0282;CS0660;CS0661;CS1717;CS1718;CS8618;CS8860;CS8974;CS8981;IDE0060;IDE1006;CA2255</NoWarn>
  </PropertyGroup>

  <!-- NuGet packaging metadata. The PackageId is EXPLICIT because the assembly keeps the
       `testing_package` class-convention name: without this property, `dotnet pack` defaults the
       package id to the assembly name and the host publishes as `testing_package`, the one
       package outside the go.* family, with its five converted subpackages (fstest, iotest, quick,
       slogtest, internal/testdeps) declaring their dependency on that off-convention id. -->
  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>go.testing</PackageId>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageDescription>testing ($(TargetFramework) - $(Configuration)) -- hand-implemented C# counterpart of Go's testing package; the go2cs Phase-4 test host</PackageDescription>
    <PackageProjectUrl>https://github.com/ritchiecarroll/go2cs</PackageProjectUrl>
    <PackageIcon>go2cs.png</PackageIcon>
    <PackageTags>testing;go2cs;Golang;go</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="go2cs.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="go2cs.ico" Pack="true" PackagePath="" Visible="false" />
    <None Include="LICENSE" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/LICENSE')" />
    <None Include="NOTICE" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/NOTICE')" />
    <None Include="AUTHORS" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/AUTHORS')" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host's own guards live in GolibTests (the MSTest tier that already binds converted
         packages — see the sha3 note there). They exercise TestExecution's INTERNAL surface: the
         constructor and the record/report entry points a converted test never calls, and the ones
         a runaway suite reaches. Exposing them this way rather than widening the package's PUBLIC
         API keeps `go.testing`'s published surface exactly the Go testing surface plus the host
         types it already had to publish. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>GolibTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- `testing` is a HAND-OWNED package (like `unsafe`): the converter never queues it, so this
         project compiles only the files in THIS folder. The subdirectories are ordinary converted
         stdlib packages (testing/fstest, testing/iotest, testing/quick, testing/slogtest,
         testing/internal/testdeps) with their own projects — the SDK's default `**/*.cs` glob would
         otherwise swallow them. -->
    <Compile Remove="**/*.cs" />
    <Compile Include="*.cs" />
    <!-- Converted test artifacts share this folder but belong to the colocated testing.tests.csproj,
         which compiles them. IDENTICAL in shape and purpose to the IP-4 exclusion the converter emits
         into every converted production csproj — it is here by hand only because this project is
         hand-owned and no emission maintains it. It must follow the Include above, which would
         otherwise re-add the very files the sibling project owns. -->
    <Compile Remove="*_test.cs;package_test_info.cs;go2cs_test_host.cs" />
    <None Remove="*/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host stays deliberately LEAN — it is a FIXED reference of every converted test project,
         so whatever it pulls in sits underneath every suite, that package's own included. golib is
         the runtime; `time` is here for exactly one member, testing.T.Deadline, whose Go signature
         returns a real time.Time and which no primitive or golib stand-in can satisfy (see
         testing.cs). `fmt` was deliberately ABSENT until 2026-09-03, when the host began
         formatting through it as Go's own testing does; TestFormat's remarks carry the two
         reasons that kept it out, the measurements that retired them, and the cost accepted
         for it (this closure 38 → 58 projects, a cold test-host build 9s → 19s). -->
    <ProjectReference Include="../golib/golib.csproj" />
    <ProjectReference Include="../time/time.csproj" />
    <ProjectReference Include="../fmt/fmt.csproj" />
    <!-- Go 1.24: TB.Context() returns context.Context. Go's own testing.go imports context
         (testing.go:402), so this edge exists in Go's package graph too and adds no cycle. -->
    <ProjectReference Include="../context/context.csproj" />
    <ProjectReference Include="../../gen/go2cs-gen/go2cs-gen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="All" />
  </ItemGroup>

  <!-- Include the per-package README (hand-owned, like this whole package) in the NuGet package —
       the same Exists-conditioned shape the converter's csproj template emits for converted packages. -->
  <PropertyGroup Condition="'$(OutputType)'=='Library' AND Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(OutputType)'=='Library' AND Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="" Condition="!Exists('$(MSBuildProjectDirectory)/LICENSE')" />
  </ItemGroup>
</Project>

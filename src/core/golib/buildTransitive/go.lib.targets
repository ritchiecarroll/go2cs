<Project>
  <!--
    go.lib.targets - Gbtc
    Copyright © 2026 The go2cs Authors. All rights reserved.

    Use of this source code is governed by an MIT-style license
    that can be found in the LICENSE file.

    A RID-SELECTED COMPILE ASSET for the multi-flavour go.* packages.

    A package whose C# varies by GOOS ships ONE nupkg with its flavours merged by push-nuget.ps1
    (layout L3; docs/phase4/DESIGN-multiplatform-corpus.md section 9 option (a)):

      lib/<tfm>/syscall.dll                   compile asset + RID-agnostic runtime fallback (the
                                              REFERENCE flavour, Windows)
      runtimes/win-x64/lib/<tfm>/syscall.dll  runtime asset, selected on win-x64
      runtimes/linux-x64/lib/<tfm>/syscall.dll runtime asset, selected on linux-x64
      runtimes/osx-x64/lib/<tfm>/syscall.dll  runtime asset, selected on osx-x64
      runtimes/osx-arm64/lib/<tfm>/syscall.dll runtime asset, selected on osx-arm64 (the same darwin build)

    NuGet's compile group has no RID dimension: project.assets.json lists compile = lib/<tfm> in the
    RID-less graph AND in a <tfm>/linux-x64 graph alike (measured 2026-09-24 on the published
    1.24.13.1). Only the RUNTIME asset follows the RID. So a converted closure that reaches a
    platform-divergent surface (golang.org/x/sys/unix calling syscall.Rlimit, which exists only in
    the linux flavour) compiled against the Windows surface on Linux and failed with CS0426, while
    the assembly that would load at run time had the type all along.

    This target closes that seam from the package side, so the consumer changes nothing: after
    ResolvePackageAssets, every go.* compile item whose package also ships a
    runtimes/<rid>/lib/<tfm>/ twin of the same file is swapped to that twin, together with its
    HintPath. The HintPath half is NOT optional: ResolveAssemblyReference resolves a package
    reference through HintPath first ("{HintPathFromItem}"), so moving the item identity alone left
    the compiler on lib/ (measured, before the HintPath line existed).

    THE RID is $(RuntimeIdentifier) when the build names one, else the SDK's own
    $(NETCoreSdkRuntimeIdentifier): the host the build runs on, which is the platform a
    go2cs -recurse conversion targets by default. $(GoCompileRuntimeIdentifier) overrides both.
    On win-x64 the twin is the reference flavour itself, so the swap changes the path and not the
    bytes. On a RID no go.* package ships (linux-arm64, say) nothing is swapped and the reference
    flavour compiles, exactly as before this target existed; the shipped RID set is stated in the
    design, not inferred here. Set GoRidCompileAssets=false to turn the swap off.
  -->
  <PropertyGroup>
    <GoRidCompileAssets Condition="'$(GoRidCompileAssets)' == ''">true</GoRidCompileAssets>
    <GoCompileRuntimeIdentifier Condition="'$(GoCompileRuntimeIdentifier)' == ''">$(RuntimeIdentifier)</GoCompileRuntimeIdentifier>
    <GoCompileRuntimeIdentifier Condition="'$(GoCompileRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</GoCompileRuntimeIdentifier>
  </PropertyGroup>

  <Target Name="GoSelectRidCompileAssets"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(GoRidCompileAssets)' == 'true' and '$(GoCompileRuntimeIdentifier)' != ''">
    <ItemGroup>
      <!-- The `go.` literal below is the published package-ID prefix, a question still open with the
           owner: a rename of the go.* package IDs must update this test too, or the swap silently stops. -->
      <_GoRidCompileCandidate Include="@(ResolvedCompileFileDefinitions)"
                              Condition="$([System.String]::Copy('%(ResolvedCompileFileDefinitions.NuGetPackageId)').StartsWith('go.', System.StringComparison.OrdinalIgnoreCase)) and '%(ResolvedCompileFileDefinitions.PathInPackage)' != ''" />
      <!-- The twin sits beside lib/ in the same package folder: strip PathInPackage off the item's
           full path to reach the package root, then descend runtimes/<rid>/ + PathInPackage. -->
      <_GoRidCompileCandidate>
        <GoRidTwin>$([System.IO.Path]::GetFullPath('$([System.String]::Copy('%(FullPath)').Substring(0, $([MSBuild]::Subtract($([System.String]::Copy('%(FullPath)').Length), $([System.String]::Copy('%(PathInPackage)').Length)))))runtimes/$(GoCompileRuntimeIdentifier)/%(PathInPackage)'))</GoRidTwin>
      </_GoRidCompileCandidate>
      <_GoRidCompileSwap Include="@(_GoRidCompileCandidate)"
                         Condition="Exists('%(GoRidTwin)') and '%(GoRidTwin)' != '%(FullPath)'" />

      <ResolvedCompileFileDefinitions Remove="@(_GoRidCompileSwap)" />
      <ResolvedCompileFileDefinitions Include="@(_GoRidCompileSwap->'%(GoRidTwin)')" />
      <ResolvedCompileFileDefinitions Condition="'%(ResolvedCompileFileDefinitions.GoRidTwin)' != ''">
        <HintPath>%(ResolvedCompileFileDefinitions.GoRidTwin)</HintPath>
        <PathInPackage>runtimes/$(GoCompileRuntimeIdentifier)/%(ResolvedCompileFileDefinitions.PathInPackage)</PathInPackage>
      </ResolvedCompileFileDefinitions>
    </ItemGroup>

    <Message Importance="low"
             Text="go.lib: compiling against the $(GoCompileRuntimeIdentifier) flavour of @(_GoRidCompileSwap->Count()) go.* package(s): @(_GoRidCompileSwap->'%(NuGetPackageId)', ', ')" />
  </Target>

  <!--
    THE CONSUMER USINGS. A C# project that calls converted Go names golib's types and Go's built-ins on
    nearly every line: `@string`, `slice<T>`, `ж<T>`, `channel<T>` live in namespace `go`, and `nil`,
    `len` and `goǃ` are static members of `go.builtin`. Every go.* and nugetgo.* package depends on
    go.lib, so this file reaches every such consumer, and these two global usings save each one from
    writing them (docs/ConsumingGoFromCSharp.md). A converted project that takes go.lib as a package
    receives them too; its csproj template already declares `go.builtin`, and the SDK keeps one global
    using per name (measured: identical Using items, Static casing included, emit once with no warning).
    A project reference to golib never imports buildTransitive, so the corpus is untouched.
    Set GoConsumerUsings=false to turn them off.

    Each go.* or nugetgo.* package the consumer references directly adds two more from its own
    build/<PackageId>.props (written when it was packed, by go.lib.pack.targets): its namespace, under the same
    GoConsumerUsings switch, so its Go methods are in scope; and, OPT-IN, its package class as a global alias named
    for the Go package (`hex` for go.encoding.hex_package). Set GoGlobalPackageAliases=true for the aliases. They
    are off by default because a file that also declares the alias itself fails with CS1537.
  -->
  <ItemGroup Condition="'$(GoConsumerUsings)' != 'false'">
    <Using Include="go" />
    <Using Include="go.builtin" Static="true" />
  </ItemGroup>

  <!--
    THE TRIM MODE. golib derives a Go struct's size, layout and call arguments from its fields by reflection, so a full
    trim that removes field metadata breaks converted code at type initialization. A converted project's csproj template
    sets TrimMode=partial (trim the framework only); a hand-written consumer of the packages got the SDK's full trim
    under PublishAot or PublishTrimmed, and its Native AOT executable crashed at startup (2026-10-06, the published
    1.24.13.4: go.internal.cpu_package+option "reports no instance fields", exit 2). The same default is set here, so a
    consumer gets the configuration a converted project gets wherever the project came from, and one who chose a mode
    keeps the choice. The SDK sets no TrimMode in evaluation (read: empty after a full evaluation under both PublishAot
    and PublishTrimmed); its trimmers default an empty one themselves, so this default reaches them.
  -->
  <PropertyGroup>
    <TrimMode Condition="'$(TrimMode)'==''">partial</TrimMode>
  </PropertyGroup>

  <!--
    THE PACKAGES' OWN SYMBOL FILES IN THE CONSUMER'S OUTPUT. Each go.* package ships its assemblies' .pdb beside
    them, and the converted runtime reads a frame's file:line (runtime.Caller, debug.Stack, a panic's traceback) from
    the .pdb beside the APPLICATION, never from the package folder: without a copy, every std frame prints no
    file:line. The SDK's own switch copies package symbol files to the output (and so to a publish); it is set here
    unless the consumer already chose, and GoCopyPackageSymbols=false leaves it untouched. It applies to every
    package that ships symbols, not only go.* ones: the SDK's switch has no per-package form. A project reference to
    golib never imports buildTransitive, so the corpus and the -tests hosts are untouched.
  -->
  <PropertyGroup Condition="'$(GoCopyPackageSymbols)' != 'false' and '$(CopyDebugSymbolFilesFromPackages)' == ''">
    <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <!-- The symbol files beside a single-file host, on every publish (see the file). -->
  <Import Project="$(MSBuildThisFileDirectory)go.lib.symbols.targets" Condition="'$(GoLibSymbolsTargetsImported)' != 'true'" />

  <!--
    THE BUILD-SIDE GO2CS DIAGNOSTIC REGISTRY. A GO2CS code in the range 3000-3999 is raised in the C# build by
    go2cs's MSBuild targets, and this file is the only targets file that raises one. Each code is ONE property in
    the block below, named Go2csDiagnostic<Name> and holding the code, and the task that raises it names the
    property: <Error Code="$(Go2csDiagnostic<Name>)" ... /> or <Warning Code="$(Go2csDiagnostic<Name>)" ... />.
    The other two sides keep their own registries: go2cs-gen's 0001-0999 in GeneratorDiagnostics.cs, the
    converter's 1000-2999 in src/go2cs/diagnosticOutput.go. Every code has one row in docs/DiagnosticCodes.md,
    and the repoguard test TestGo2csDiagnosticCodeRegistry fails by name on a code that is not registered, is
    registered twice or outside its range, is never raised, or has no row.
  -->
  <PropertyGroup Label="Go2csDiagnosticCodes">
    <Go2csDiagnosticCompilerFloor>GO2CS3001</Go2csDiagnosticCompilerFloor>
  </PropertyGroup>

  <!--
    GO-STRING LITERALS IN ANY SLOTS, AND THE COMPILER THEY NEED. Outside the standard library the converter passes
    Go's `fmt.Println("hello")` as a bare C# literal, and go2cs-gen's LiteralInterceptorGenerator intercepts the call
    so the callee receives a Go string; without the interception the callee would see System.String. So:
    - the interceptors' namespace is admitted (without it every intercepted call is CS9137);
    - a go2cs-gen that cannot LOAD is an error, not the compiler's warning: CS8032 (cannot be instantiated), CS8034
      (cannot be loaded), CS8784 (a generator failed to initialize), CS8785 (a generator threw), and CS9057 (the
      generator references a newer compiler than the one running it). The build would otherwise go on without the
      interceptors and exit 0. The repository's own projects get the same list from src/Directory.Build.props.
    - GO2CS3001 refuses a compiler below Roslyn 4.14, the floor go2cs-gen is built against (GetInterceptableLocation),
      read from $(CompilerApiVersion), which the SDK sets from the compiler the build runs. A .NET 10 SDK build runs
      its own Roslyn 5.0; this catches an older compiler a host or a pinned Microsoft.Net.Compilers.Toolset brings.
  -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);go2cs.Interceptors</InterceptorsNamespaces>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS8034;CS8784;CS8785;CS9057</WarningsAsErrors>
    <Go2csCompilerFloor>4.14</Go2csCompilerFloor>
  </PropertyGroup>

  <Target Name="Go2csCompilerFloor" BeforeTargets="CoreCompile" Condition="'$(Language)' == 'C#' and '$(CompilerApiVersion)' != ''">
    <PropertyGroup>
      <_Go2csCompilerApi>$(CompilerApiVersion.Replace('roslyn', ''))</_Go2csCompilerApi>
    </PropertyGroup>
    <Error Code="$(Go2csDiagnosticCompilerFloor)"
           Condition="$([MSBuild]::VersionLessThan('$(_Go2csCompilerApi)', '$(Go2csCompilerFloor)'))"
           Text="The C# compiler (API $(CompilerApiVersion)) is older than Roslyn $(Go2csCompilerFloor), which go2cs-gen needs to box Go string literals in any slots; without it a converted program would see System.String where Go has a string. Build with a .NET 10 SDK and its own compiler." />
  </Target>

  <!-- A converted package packed against the go.* packages (a `go2cs -recurse=nuget` conversion) writes its own
       usings into build/<PackageId>.props at pack time (see the file). Inert unless the project's Product is go2cs
       and it is being packed; the in-tree standard library imports the same file from src/Directory.Build.targets. -->
  <Import Project="$(MSBuildThisFileDirectory)go.lib.pack.targets" Condition="'$(GoLibPackTargetsImported)' != 'true'" />
</Project>

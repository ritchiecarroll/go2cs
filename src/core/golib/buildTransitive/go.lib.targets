<Project>
  <!--
    go.lib.targets - Gbtc
    Copyright © 2026 The go2cs Authors. All rights reserved.

    Use of this source code is governed by an MIT-style license
    that can be found in the LICENSE file.

    A RID-SELECTED COMPILE ASSET for the multi-flavour go.* packages.

    A package whose C# varies by GOOS ships ONE nupkg with its flavours merged by push-nuget.ps1
    (layout L3; docs/phase4/DESIGN-multiplatform-corpus.md section 9 option (a)):

      lib/<tfm>/syscall.dll                   compile asset + RID-agnostic runtime fallback (the
                                              REFERENCE flavour, Windows)
      runtimes/win-x64/lib/<tfm>/syscall.dll  runtime asset, selected on win-x64
      runtimes/linux-x64/lib/<tfm>/syscall.dll runtime asset, selected on linux-x64
      runtimes/osx-x64/lib/<tfm>/syscall.dll  runtime asset, selected on osx-x64
      runtimes/osx-arm64/lib/<tfm>/syscall.dll runtime asset, selected on osx-arm64 (the same darwin build)

    NuGet's compile group has no RID dimension: project.assets.json lists compile = lib/<tfm> in the
    RID-less graph AND in a <tfm>/linux-x64 graph alike (measured 2026-09-24 on the published
    1.24.13.1). Only the RUNTIME asset follows the RID. So a converted closure that reaches a
    platform-divergent surface (golang.org/x/sys/unix calling syscall.Rlimit, which exists only in
    the linux flavour) compiled against the Windows surface on Linux and failed with CS0426, while
    the assembly that would load at run time had the type all along.

    This target closes that seam from the package side, so the consumer changes nothing: after
    ResolvePackageAssets, every go.* compile item whose package also ships a
    runtimes/<rid>/lib/<tfm>/ twin of the same file is swapped to that twin, together with its
    HintPath. The HintPath half is NOT optional: ResolveAssemblyReference resolves a package
    reference through HintPath first ("{HintPathFromItem}"), so moving the item identity alone left
    the compiler on lib/ (measured, before the HintPath line existed).

    THE RID is $(RuntimeIdentifier) when the build names one, else the host the build runs on, which
    is the platform a go2cs -recurse conversion targets by default: the SDK's PORTABLE RID
    ($(NETCoreSdkPortableRuntimeIdentifier)), then its own ($(NETCoreSdkRuntimeIdentifier)). The
    portable one comes first because a distro-built SDK reports a distro RID as its own (Ubuntu's
    packaged 10.0.112 reports ubuntu.24.04-x64, with linux-x64 as the portable one; measured
    2026-11-09), and no package ships a runtimes/<distro rid>/ twin. $(GoCompileRuntimeIdentifier)
    overrides all three. On win-x64 the twin is the reference flavour itself, so the swap changes
    the path and not the bytes. Set GoRidCompileAssets=false to turn the swap off.

    THE FLAVOUR is resolved through the SDK's RID graph ($(RuntimeIdentifierGraphPath)), as the host
    resolves the RUNTIME asset: breadth-first from the RID, nearest first, the first RID a package
    ships a runtimes/<rid>/ folder for. So linux-musl-x64 compiles against linux-x64, and
    linux-musl-arm64 and linux-bionic-arm64 against linux-arm64 once a package ships it. Only a
    RID-SPLIT package (one with a runtimes/ folder) is resolved: the platform-neutral go.* packages,
    most of them, ship lib/ alone and have nothing to swap or to refuse. An SDK without the graph
    file resolves the exact RID only.

    A RID NO go.* PACKAGE RESOLVES (linux-arm64, for one) is refused by its own target, which runs
    whether or not the swap is on. On a platform of another operating system, or of the same one with
    another system-call ABI (linux-arm64 against the linux-x64 flavour), the program would run code
    that does not describe its host: GO2CS3003, a build error naming the RID and the first package.
    On a Windows platform the packages do not ship (win-arm64), the Windows flavour IS that operating
    system's, so it is GO2CS3004, a warning, and the build goes on. A cross-build for a shipped RID
    from an unshipped host sets RuntimeIdentifier and never reaches either. GoAllowReferenceFlavor=true
    turns both off, and the program then RUNS THE WINDOWS FLAVOUR wherever it runs. It is honoured
    ONLY as a global property (-p:GoAllowReferenceFlavor=true): this file is imported after the
    project body and sets it to false, which a global property overrides and a project file cannot,
    so a library cannot switch the refusal off for every consumer that builds it. The shipped RID set
    is the packages' own runtimes/ folders, never a list here.
  -->
  <PropertyGroup>
    <GoRidCompileAssets Condition="'$(GoRidCompileAssets)' == ''">true</GoRidCompileAssets>
    <GoCompileRuntimeIdentifier Condition="'$(GoCompileRuntimeIdentifier)' == ''">$(RuntimeIdentifier)</GoCompileRuntimeIdentifier>
    <GoCompileRuntimeIdentifier Condition="'$(GoCompileRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</GoCompileRuntimeIdentifier>
    <GoCompileRuntimeIdentifier Condition="'$(GoCompileRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</GoCompileRuntimeIdentifier>
    <GoAllowReferenceFlavor>false</GoAllowReferenceFlavor>
  </PropertyGroup>

  <!-- The RID-graph walk. The graph is read with a regular expression over its `"rid": { "#import": [...] }`
       entries, so the task needs no JSON library beyond what every MSBuild host carries. -->
  <UsingTask TaskName="GoResolveRidFlavor" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Rid ParameterType="System.String" Required="true" />
      <GraphPath ParameterType="System.String" />
      <Candidates ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Resolved ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
      <WindowsOs ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var graph = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrEmpty(GraphPath) && File.Exists(GraphPath))
        {
            foreach (Match m in Regex.Matches(File.ReadAllText(GraphPath), "\"([^\"]+)\"\\s*:\\s*\\{\\s*\"#import\"\\s*:\\s*\\[([^\\]]*)\\]"))
            {
                var imports = new List<string>();
                foreach (Match q in Regex.Matches(m.Groups[2].Value, "\"([^\"]+)\""))
                    imports.Add(q.Groups[1].Value);
                graph[m.Groups[1].Value] = imports;
            }
        }
        var chain = new List<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { Rid };
        var queue = new Queue<string>();
        queue.Enqueue(Rid);
        while (queue.Count > 0)
        {
            string r = queue.Dequeue();
            chain.Add(r);
            List<string> next;
            if (graph.TryGetValue(r, out next))
                foreach (string i in next)
                    if (seen.Add(i)) queue.Enqueue(i);
        }
        WindowsOs = false;
        foreach (string r in chain)
            if (string.Equals(r, "win", StringComparison.OrdinalIgnoreCase)) WindowsOs = true;
        var flavourOf = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var resolved = new List<ITaskItem>();
        foreach (ITaskItem c in Candidates)
        {
            string root = c.GetMetadata("GoRidPackageRoot");
            string flavour;
            if (!flavourOf.TryGetValue(root, out flavour))
            {
                flavour = "";
                foreach (string r in chain)
                    if (Directory.Exists(Path.Combine(root, "runtimes", r))) { flavour = r; break; }
                flavourOf[root] = flavour;
            }
            var item = new TaskItem(c);
            item.SetMetadata("GoRidFlavor", flavour);
            resolved.Add(item);
        }
        Resolved = resolved.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_GoResolveRidFlavors" Condition="'$(GoCompileRuntimeIdentifier)' != ''">
    <ItemGroup>
      <!-- The `go.` literal below is the published package-ID prefix, a question still open with the
           owner: a rename of the go.* package IDs must update this test too, or the swap silently stops. -->
      <_GoRidCompileCandidate Include="@(ResolvedCompileFileDefinitions)"
                              Condition="$([System.String]::Copy('%(ResolvedCompileFileDefinitions.NuGetPackageId)').StartsWith('go.', System.StringComparison.OrdinalIgnoreCase)) and '%(ResolvedCompileFileDefinitions.PathInPackage)' != ''" />
      <!-- The package root: strip PathInPackage off the item's full path. -->
      <_GoRidCompileCandidate>
        <GoRidPackageRoot>$([System.String]::Copy('%(FullPath)').Substring(0, $([MSBuild]::Subtract($([System.String]::Copy('%(FullPath)').Length), $([System.String]::Copy('%(PathInPackage)').Length)))))</GoRidPackageRoot>
      </_GoRidCompileCandidate>
      <!-- RID-SPLIT only: a package with a runtimes/ folder. -->
      <_GoRidSplitCandidate Include="@(_GoRidCompileCandidate)" Condition="Exists('%(GoRidPackageRoot)runtimes')" />
    </ItemGroup>
    <GoResolveRidFlavor Rid="$(GoCompileRuntimeIdentifier)" GraphPath="$(RuntimeIdentifierGraphPath)"
                        Candidates="@(_GoRidSplitCandidate)" Condition="'@(_GoRidSplitCandidate)' != ''">
      <Output TaskParameter="Resolved" ItemName="_GoRidResolved" />
      <Output TaskParameter="WindowsOs" PropertyName="_GoRidWindowsOs" />
    </GoResolveRidFlavor>
  </Target>

  <Target Name="GoSelectRidCompileAssets"
          AfterTargets="ResolvePackageAssets"
          DependsOnTargets="_GoResolveRidFlavors"
          Condition="'$(GoRidCompileAssets)' == 'true' and '$(GoCompileRuntimeIdentifier)' != ''">
    <ItemGroup>
      <!-- The twin sits beside lib/ in the same package folder: runtimes/<flavour>/ + PathInPackage. -->
      <_GoRidCompileTwin Include="@(_GoRidResolved)" Condition="'%(_GoRidResolved.GoRidFlavor)' != ''" />
      <_GoRidCompileTwin>
        <GoRidTwin>$([System.IO.Path]::GetFullPath('%(GoRidPackageRoot)runtimes/%(GoRidFlavor)/%(PathInPackage)'))</GoRidTwin>
      </_GoRidCompileTwin>
      <_GoRidCompileSwap Include="@(_GoRidCompileTwin)"
                         Condition="Exists('%(GoRidTwin)') and '%(GoRidTwin)' != '%(FullPath)'" />

      <ResolvedCompileFileDefinitions Remove="@(_GoRidCompileSwap)" />
      <ResolvedCompileFileDefinitions Include="@(_GoRidCompileSwap->'%(GoRidTwin)')" />
      <ResolvedCompileFileDefinitions Condition="'%(ResolvedCompileFileDefinitions.GoRidTwin)' != ''">
        <HintPath>%(ResolvedCompileFileDefinitions.GoRidTwin)</HintPath>
        <PathInPackage>runtimes/%(ResolvedCompileFileDefinitions.GoRidFlavor)/%(ResolvedCompileFileDefinitions.PathInPackage)</PathInPackage>
      </ResolvedCompileFileDefinitions>
    </ItemGroup>

    <Message Importance="low"
             Text="go.lib: compiling $(GoCompileRuntimeIdentifier) against the resolved flavour of @(_GoRidCompileSwap->Count()) go.* package(s): @(_GoRidCompileSwap->'%(NuGetPackageId) (%(GoRidFlavor))', ', ')" />
  </Target>

  <Target Name="GoRefuseUnshippedRid"
          AfterTargets="ResolvePackageAssets"
          DependsOnTargets="_GoResolveRidFlavors"
          Condition="'$(GoAllowReferenceFlavor)' != 'true' and '$(GoCompileRuntimeIdentifier)' != ''">
    <ItemGroup>
      <_GoRidUnshipped Include="@(_GoRidResolved)" Condition="'%(_GoRidResolved.GoRidFlavor)' == ''" />
    </ItemGroup>
    <PropertyGroup Condition="'@(_GoRidUnshipped)' != ''">
      <_GoRidUnshippedIds>@(_GoRidUnshipped->'%(NuGetPackageId)'->Distinct())</_GoRidUnshippedIds>
      <_GoRidUnshippedFirst>$(_GoRidUnshippedIds);</_GoRidUnshippedFirst>
      <_GoRidUnshippedFirst>$(_GoRidUnshippedFirst.Substring(0, $(_GoRidUnshippedFirst.IndexOf(';'))))</_GoRidUnshippedFirst>
      <_GoRidUnshippedCount>@(_GoRidUnshipped->'%(NuGetPackageId)'->Distinct()->Count())</_GoRidUnshippedCount>
    </PropertyGroup>
    <Error Code="$(Go2csDiagnosticUnshippedRid)"
           Condition="'@(_GoRidUnshipped)' != '' and '$(_GoRidWindowsOs)' != 'true'"
           Text="The go.* packages do not ship the $(GoCompileRuntimeIdentifier) platform: $(_GoRidUnshippedFirst), one of $(_GoRidUnshippedCount) platform-specific go.* package(s) in this build, has no flavour for it, so the program would compile against, and run, the Windows flavour. Build for a RID the packages ship, or pass -p:GoAllowReferenceFlavor=true to compile against the Windows flavour knowingly: the program then runs the Windows flavour. See https://github.com/ritchiecarroll/go2cs/blob/master/docs/KnownIssues.md#the-packages-do-not-ship-linux-arm64" />
    <Warning Code="$(Go2csDiagnosticUnshippedWindowsRid)"
             Condition="'@(_GoRidUnshipped)' != '' and '$(_GoRidWindowsOs)' == 'true'"
             Text="The go.* packages do not ship the $(GoCompileRuntimeIdentifier) platform: $(_GoRidUnshippedFirst), one of $(_GoRidUnshippedCount) platform-specific go.* package(s) in this build, compiles against, and runs, its Windows flavour. That is this platform's operating system, so the program runs, but what Go decides by architecture when the package was converted follows amd64. Pass -p:GoAllowReferenceFlavor=true to silence this. See https://github.com/ritchiecarroll/go2cs/blob/master/docs/KnownIssues.md#the-packages-do-not-ship-linux-arm64" />
  </Target>

  <!--
    THE CONSUMER USINGS. A C# project that calls converted Go names golib's types and Go's built-ins on
    nearly every line: `@string`, `slice<T>`, `ж<T>`, `channel<T>` live in namespace `go`, and `nil`,
    `len` and `goǃ` are static members of `go.builtin`. Every go.* and nugetgo.* package depends on
    go.lib, so this file reaches every such consumer, and these two global usings save each one from
    writing them (docs/ConsumingGoFromCSharp.md). A converted project that takes go.lib as a package
    receives them too; its csproj template already declares `go.builtin`, and the SDK keeps one global
    using per name (measured: identical Using items, Static casing included, emit once with no warning).
    A project reference to golib never imports buildTransitive, so the corpus is untouched.
    Set GoConsumerUsings=false to turn them off.

    Each go.* or nugetgo.* package the consumer references directly adds two more from its own
    build/<PackageId>.props (written when it was packed, by go.lib.pack.targets): its namespace, under the same
    GoConsumerUsings switch, so its Go methods are in scope; and, OPT-IN, its package class as a global alias named
    for the Go package (`hex` for go.encoding.hex_package). Set GoGlobalPackageAliases=true for the aliases. They
    are off by default because a file that also declares the alias itself fails with CS1537.
  -->
  <ItemGroup Condition="'$(GoConsumerUsings)' != 'false'">
    <Using Include="go" />
    <Using Include="go.builtin" Static="true" />
  </ItemGroup>

  <!--
    THE ALIAS WARNING. The way to call converted Go from C# is one lowercase alias per package
    (`using strings = go.strings_package;`, docs/ConsumingGoFromCSharp.md), and each such alias raises warning
    CS8981: an all-lowercase type name may become a C# keyword one day. The aliases are deliberate, so the same
    consumer who gets the usings above gets the warning off, under the same switch: GoConsumerUsings=false turns
    both back on. A project that references a conversion as projects never imports this file and writes the
    NoWarn itself.
  -->
  <PropertyGroup Condition="'$(GoConsumerUsings)' != 'false'">
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <!--
    THE TRIM MODE. golib derives a Go struct's size, layout and call arguments from its fields by reflection, so a full
    trim that removes field metadata breaks converted code at type initialization. A converted project's csproj template
    sets TrimMode=partial (trim the framework only); a hand-written consumer of the packages got the SDK's full trim
    under PublishAot or PublishTrimmed, and its Native AOT executable crashed at startup (2026-10-06, the published
    1.24.13.4: go.internal.cpu_package+option "reports no instance fields", exit 2). The same default is set here, so a
    consumer gets the configuration a converted project gets wherever the project came from, and one who chose a mode
    keeps the choice. The SDK sets no TrimMode in evaluation (read: empty after a full evaluation under both PublishAot
    and PublishTrimmed); its trimmers default an empty one themselves, so this default reaches them.
  -->
  <PropertyGroup>
    <TrimMode Condition="'$(TrimMode)'==''">partial</TrimMode>
  </PropertyGroup>

  <!--
    THE PACKAGES' OWN SYMBOL FILES IN THE CONSUMER'S OUTPUT. Each go.* package ships its assemblies' .pdb beside
    them, and the converted runtime reads a frame's file:line (runtime.Caller, debug.Stack, a panic's traceback) from
    the .pdb beside the APPLICATION, never from the package folder: without a copy, every std frame prints no
    file:line. The SDK's own switch copies package symbol files to the output (and so to a publish); it is set here
    unless the consumer already chose, and GoCopyPackageSymbols=false leaves it untouched. It applies to every
    package that ships symbols, not only go.* ones: the SDK's switch has no per-package form. A project reference to
    golib never imports buildTransitive, so the corpus and the -tests hosts are untouched.
  -->
  <PropertyGroup Condition="'$(GoCopyPackageSymbols)' != 'false' and '$(CopyDebugSymbolFilesFromPackages)' == ''">
    <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <!-- The symbol files beside a single-file host, on every publish (see the file). -->
  <Import Project="$(MSBuildThisFileDirectory)go.lib.symbols.targets" Condition="'$(GoLibSymbolsTargetsImported)' != 'true'" />

  <!--
    THE BUILD-SIDE GO2CS DIAGNOSTIC REGISTRY. A GO2CS code in the range 3000-3999 is raised in the C# build by
    go2cs's MSBuild targets, and this file is the only targets file that raises one. Each code is ONE property in
    the block below, named Go2csDiagnostic<Name> and holding the code, and the task that raises it names the
    property: <Error Code="$(Go2csDiagnostic<Name>)" ... /> or <Warning Code="$(Go2csDiagnostic<Name>)" ... />.
    The other two sides keep their own registries: go2cs-gen's 0001-0999 in GeneratorDiagnostics.cs, the
    converter's 1000-2999 in src/go2cs/diagnosticOutput.go. Every code has one row in docs/DiagnosticCodes.md,
    and the repoguard test TestGo2csDiagnosticCodeRegistry fails by name on a code that is not registered, is
    registered twice or outside its range, is never raised, or has no row.
  -->
  <PropertyGroup Label="Go2csDiagnosticCodes">
    <Go2csDiagnosticCompilerFloor>GO2CS3001</Go2csDiagnosticCompilerFloor>
    <Go2csDiagnosticBreakFloor>GO2CS3002</Go2csDiagnosticBreakFloor>
    <Go2csDiagnosticUnshippedRid>GO2CS3003</Go2csDiagnosticUnshippedRid>
    <Go2csDiagnosticUnshippedWindowsRid>GO2CS3004</Go2csDiagnosticUnshippedWindowsRid>
  </PropertyGroup>

  <!--
    GO-STRING LITERALS IN ANY SLOTS, AND THE COMPILER THEY NEED. Outside the standard library the converter passes
    Go's `fmt.Println("hello")` as a bare C# literal, and go2cs-gen's LiteralInterceptorGenerator intercepts the call
    so the callee receives a Go string; without the interception the callee would see System.String. So:
    - the interceptors' namespace is admitted (without it every intercepted call is CS9137);
    - a go2cs-gen that cannot LOAD is an error, not the compiler's warning: CS8032 (cannot be instantiated), CS8034
      (cannot be loaded), CS8784 (a generator failed to initialize), CS8785 (a generator threw), and CS9057 (the
      generator references a newer compiler than the one running it). The build would otherwise go on without the
      interceptors and exit 0. The repository's own projects get the same list from src/Directory.Build.props.
    - GO2CS3001 refuses a compiler below Roslyn 4.14, the floor go2cs-gen is built against (GetInterceptableLocation),
      read from $(CompilerApiVersion), which the SDK sets from the compiler the build runs. A .NET 10 SDK build runs
      its own Roslyn 5.0; this catches an older compiler a host or a pinned Microsoft.Net.Compilers.Toolset brings.
  -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);go2cs.Interceptors</InterceptorsNamespaces>
    <WarningsAsErrors>$(WarningsAsErrors);CS8032;CS8034;CS8784;CS8785;CS9057</WarningsAsErrors>
    <Go2csCompilerFloor>4.14</Go2csCompilerFloor>
  </PropertyGroup>

  <Target Name="Go2csCompilerFloor" BeforeTargets="CoreCompile" Condition="'$(Language)' == 'C#' and '$(CompilerApiVersion)' != ''">
    <PropertyGroup>
      <_Go2csCompilerApi>$(CompilerApiVersion.Replace('roslyn', ''))</_Go2csCompilerApi>
    </PropertyGroup>
    <Error Code="$(Go2csDiagnosticCompilerFloor)"
           Condition="$([MSBuild]::VersionLessThan('$(_Go2csCompilerApi)', '$(Go2csCompilerFloor)'))"
           Text="The C# compiler (API $(CompilerApiVersion)) is older than Roslyn $(Go2csCompilerFloor), which go2cs-gen needs to box Go string literals in any slots; without it a converted program would see System.String where Go has a string. Build with a .NET 10 SDK and its own compiler." />
  </Target>

  <!--
    THE BREAK FLOOR. Within one Go minor every go.* revision keeps the members the one before it exported, except
    where a release announces a break (its CompatibilitySuppressions.xml entries; the release notes' "Upgrading").
    A package built below such a release still restores beside it: B4's range [build, next Go minor) admits the newer
    go.*, and a direct reference overrides the exact sibling pins with NU1608 warnings. It then throws
    MissingMethodException at run time (docs/phase4/RECORD-nuget-sibling-pins.md, arms a2 and h1). So the build
    fails, as GO2CS3002, for each go2cs-built package it resolves that was built below $(GoBreakFloor), the newest
    release that made such a break (docs/phase4/DESIGN-go-break-floor.md):
    - a converted module (a package that ships go2cs/source-metadata.txt, whatever its ID) was built on the release
      its `go2cs-release` line names; a module whose metadata names none counts as below the floor;
    - a nugetgo.* package without that file was not packed by nugetgo-pack.ps1, which mints every nugetgo.* ID and
      writes the file into each, so what it was built on is unknown and it counts as below the floor too;
    - a go.* package was built on its own version;
    - any other package is skipped. A module packed under another ID without the file is not checked.
    A prerelease counts as its release. Each package below the floor gets its own error, and then one more error stops
    the target, so CoreCompile never runs and nothing is compiled, copied or published. The floor is set here
    unconditionally, after the project body, so a project body cannot lower it; a Directory.Build.targets imports after
    this file and can, which is the opt-out by another name. push-nuget refuses a release whose floor disagrees with
    its suppression files. Set GoAllowBelowBreakFloor=true to build anyway: each error becomes a warning with the same
    code, and the build goes on.
  -->
  <PropertyGroup>
    <GoBreakFloor>1.26.10.3</GoBreakFloor>
  </PropertyGroup>

  <Target Name="GoCheckBreakFloor" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_GoBreakFloorAsset Include="@(ResolvedCompileFileDefinitions)"
                          Condition="'%(ResolvedCompileFileDefinitions.NuGetPackageId)' != '' and '%(ResolvedCompileFileDefinitions.PathInPackage)' != ''" />
      <_GoBreakFloorAsset Include="@(RuntimeCopyLocalItems)"
                          Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' != '' and '%(RuntimeCopyLocalItems.PathInPackage)' != ''" />
      <!-- The package folder: the asset's full path less its path inside the package, as GoSelectRidCompileAssets
           reaches the twin. One item per folder carries the package's ID and version. -->
      <_GoBreakFloorAsset>
        <GoPackageRoot>$([System.String]::Copy('%(FullPath)').Substring(0, $([MSBuild]::Subtract($([System.String]::Copy('%(FullPath)').Length), $([System.String]::Copy('%(PathInPackage)').Length)))))</GoPackageRoot>
      </_GoBreakFloorAsset>
      <_GoBreakFloorRoot Include="@(_GoBreakFloorAsset->'%(GoPackageRoot)')" />
    </ItemGroup>

    <RemoveDuplicates Inputs="@(_GoBreakFloorRoot)">
      <Output TaskParameter="Filtered" ItemName="_GoBreakFloorPackage" />
    </RemoveDuplicates>

    <ItemGroup>
      <_GoBreakFloorPackage>
        <GoSourceMetadata>%(_GoBreakFloorPackage.Identity)go2cs/source-metadata.txt</GoSourceMetadata>
      </_GoBreakFloorPackage>
      <_GoBreakFloorPackage Condition="Exists('%(_GoBreakFloorPackage.GoSourceMetadata)')">
        <GoKind>module</GoKind>
        <GoBuiltOn>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('%(_GoBreakFloorPackage.GoSourceMetadata)')), '(?m)^go2cs-release[ \t]+([0-9][^\s]*)').Groups[1].Value)</GoBuiltOn>
      </_GoBreakFloorPackage>
      <_GoBreakFloorPackage Condition="'%(_GoBreakFloorPackage.GoKind)' == '' and $([System.String]::Copy('%(_GoBreakFloorPackage.NuGetPackageId)').StartsWith('go.', System.StringComparison.OrdinalIgnoreCase))">
        <GoKind>go</GoKind>
        <GoBuiltOn>%(_GoBreakFloorPackage.NuGetPackageVersion)</GoBuiltOn>
      </_GoBreakFloorPackage>
      <_GoBreakFloorPackage Condition="'%(_GoBreakFloorPackage.GoKind)' == '' and $([System.String]::Copy('%(_GoBreakFloorPackage.NuGetPackageId)').StartsWith('nugetgo.', System.StringComparison.OrdinalIgnoreCase))">
        <GoKind>module</GoKind>
      </_GoBreakFloorPackage>
      <_GoBreakFloorPackage Remove="@(_GoBreakFloorPackage)" Condition="'%(_GoBreakFloorPackage.GoKind)' == ''" />
      <_GoBreakFloorPackage Condition="'%(_GoBreakFloorPackage.GoBuiltOn)' != ''">
        <GoRelease>$([System.Text.RegularExpressions.Regex]::Replace('%(_GoBreakFloorPackage.GoBuiltOn)', '-.*$', ''))</GoRelease>
      </_GoBreakFloorPackage>
      <_GoBreakFloorBelow Include="@(_GoBreakFloorPackage)" Condition="'%(_GoBreakFloorPackage.GoRelease)' == ''">
        <GoBuiltOnText>an unknown release</GoBuiltOnText>
      </_GoBreakFloorBelow>
      <_GoBreakFloorBelow Include="@(_GoBreakFloorPackage)" Condition="'%(_GoBreakFloorPackage.GoRelease)' != '' and $([MSBuild]::VersionLessThan('%(_GoBreakFloorPackage.GoRelease)', '$(GoBreakFloor)'))">
        <GoBuiltOnText>%(_GoBreakFloorPackage.GoBuiltOn)</GoBuiltOnText>
      </_GoBreakFloorBelow>
      <!-- What the package is, and what to reference instead: a converted module names its own newer revision, and how
           to find it; a go.* package is usually brought in by another package, so either one is the remedy. -->
      <_GoBreakFloorBelow Condition="'%(_GoBreakFloorBelow.GoKind)' == 'module'">
        <GoStatement>%(_GoBreakFloorBelow.NuGetPackageId) %(_GoBreakFloorBelow.NuGetPackageVersion) was built on go.* %(_GoBreakFloorBelow.GoBuiltOnText)</GoStatement>
        <GoRemedy>Reference a revision of %(_GoBreakFloorBelow.NuGetPackageId) built on go.* $(GoBreakFloor) or later (on nuget.org a deprecated revision names the one that replaces it, and each revision's go2cs/source-metadata.txt names the release it was built on; a project converted with go2cs -recurse=nuget picks it up by converting again with -nuget-map-refresh)</GoRemedy>
      </_GoBreakFloorBelow>
      <_GoBreakFloorBelow Condition="'%(_GoBreakFloorBelow.GoKind)' == 'go'">
        <GoStatement>%(_GoBreakFloorBelow.NuGetPackageId) %(_GoBreakFloorBelow.NuGetPackageVersion) is a go.* %(_GoBreakFloorBelow.GoBuiltOnText) package</GoStatement>
        <GoRemedy>Reference go.* $(GoBreakFloor) or later for it, or for the package that brings it in</GoRemedy>
      </_GoBreakFloorBelow>
    </ItemGroup>

    <PropertyGroup>
      <_GoBreakFloorWhy>below go.* $(GoBreakFloor), the newest release that changed members compiled code binds (see "Upgrading" in the go2cs release notes). Run, it would fail with MissingMethodException or a similar error.</_GoBreakFloorWhy>
    </PropertyGroup>

    <!-- One diagnostic per package. ErrorAndContinue names every package below the floor, not only the first, but
         leaves the target succeeding, so the error after them stops it before CoreCompile. -->
    <Error Code="$(Go2csDiagnosticBreakFloor)" ContinueOnError="ErrorAndContinue"
           Condition="'$(GoAllowBelowBreakFloor)' != 'true' and '%(_GoBreakFloorBelow.Identity)' != ''"
           Text="%(_GoBreakFloorBelow.GoStatement), $(_GoBreakFloorWhy) %(_GoBreakFloorBelow.GoRemedy), or set GoAllowBelowBreakFloor=true to build anyway at your own risk." />
    <Warning Code="$(Go2csDiagnosticBreakFloor)"
             Condition="'$(GoAllowBelowBreakFloor)' == 'true' and '%(_GoBreakFloorBelow.Identity)' != ''"
             Text="%(_GoBreakFloorBelow.GoStatement), $(_GoBreakFloorWhy) Built anyway, because GoAllowBelowBreakFloor=true." />
    <Error Code="$(Go2csDiagnosticBreakFloor)"
           Condition="'$(GoAllowBelowBreakFloor)' != 'true' and '@(_GoBreakFloorBelow)' != ''"
           Text="The build stops here, before compiling: @(_GoBreakFloorBelow->Count()) go2cs-built package(s) named above are below go.* $(GoBreakFloor). Set GoAllowBelowBreakFloor=true to build anyway at your own risk." />
  </Target>

  <!-- A converted package packed against the go.* packages (a `go2cs -recurse=nuget` conversion) writes its own
       usings into build/<PackageId>.props at pack time (see the file). Inert unless the project's Product is go2cs
       and it is being packed; the in-tree standard library imports the same file from src/Directory.Build.targets. -->
  <Import Project="$(MSBuildThisFileDirectory)go.lib.pack.targets" Condition="'$(GoLibPackTargetsImported)' != 'true'" />
</Project>

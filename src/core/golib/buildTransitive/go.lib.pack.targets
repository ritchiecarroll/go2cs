<Project>
  <!--
    go.lib.pack.targets - Gbtc
    Copyright © 2026 The go2cs Authors. All rights reserved.

    Use of this source code is governed by an MIT-style license
    that can be found in the LICENSE file.

    THE PACKAGE'S OWN USINGS, written at PACK time into build/<PackageId>.props.

    A converted Go package is a static class whose Go methods are extension methods, and C# brings an
    extension method into scope only through a namespace import or `using static`; a `using x = y;`
    alias never does. go.lib's consumer usings (go.lib.targets) import namespace `go`, which holds every
    package whose import path has no slash. A package whose path has one (encoding/hex lives in
    namespace `go.encoding`) needed a second, hand-written `using go.encoding;`, and without it a Go
    method call failed with CS1929, naming some unrelated package's overload.

    So each converted package ships build/<PackageId>.props, written here from the package's own
    package_info.cs. It holds:

      * the package's namespace as a global using (none when it is `go`, which go.lib already adds),
        under the same GoConsumerUsings switch as go.lib's own usings;
      * OPT-IN, under GoGlobalPackageAliases=true: the package class as a global alias named for the
        Go package (`global using hex = go.encoding.hex_package;`), so a consumer writes no using at
        all. It is off by default because a file that also declares the same alias, the form the
        documentation recommends, fails with CS1537. Two directly referenced packages with one Go name
        (math/rand and crypto/rand) give two `rand` aliases and CS1537 as well; the consumer drops one
        with <Using Remove="go.crypto.rand_package" />.

    The conditions are evaluated in the consumer's ITEM pass, after every property, so a
    GoGlobalPackageAliases or GoConsumerUsings set in the consumer's csproj body is seen here although
    NuGet imports this file ahead of that body.

    NuGet imports build/<id>.props for a DIRECT package reference only, so a consumer gets the usings of
    the packages it added and never those of the internal/* packages that arrive transitively.

    WHO GETS ONE. A project whose Product is go2cs (the converter's csproj template sets it, so no
    converted csproj changes) and that has a package_info.cs, at its root or, for a layout-L3 package,
    in a per-GOOS folder. Every flavour's copy declares the same namespace and package class, and the
    files are read from disk rather than from the compile items, so the props is the same whichever
    $(GoTargetOS) the pack ran under. golib has no package_info.cs and gets none. A pack that bundles
    SEVERAL converted packages into one nupkg (nugetgo-pack.ps1's module pack project) names their
    directories as GoPackageDirectory items, and the one props covers all of them.

    Set GoPackageUsingsProps=false to pack without the file.
  -->
  <PropertyGroup>
    <GoLibPackTargetsImported>true</GoLibPackTargetsImported>
  </PropertyGroup>

  <!--
    EXACT go.* DEPENDENCY VERSIONS. NuGet packs a ProjectReference as a MINIMUM-version dependency
    (`version="1.26.10.2"` means 1.26.10.2 or later), so a consumer's restore may mix go.* releases: go.flag
    1.26.10.1 with go.os 1.26.10.2. Within one release line the packages are built and published together, and
    a later release can change a member's shape. 1.26.10.2 turns every exported value variable into a box and a
    `ref` property, so an assembly compiled against 1.26.10.1 that reads `os.Args` as a field fails at run time
    with MissingFieldException. Pinning each project-reference dependency to its exact version (`[1.26.10.2]`)
    turns that mix into a restore error that names the packages (COORD's ruling on OQ-2,
    docs/phase4/DESIGN-crosspkg-exported-box.md).

    Only PROJECT references are rewritten. Every go.* package of one release reaches the others that way in the
    stdlib pack. A PackageReference (a converted module's reference to the published go.* packages) keeps the
    range its project file states. Set GoExactProjectReferenceVersions=false to pack minimum versions.
  -->
  <Target Name="GoExactProjectReferenceVersions"
          AfterTargets="_GetProjectReferenceVersions"
          Condition="'$(Product)' == 'go2cs' and '$(GoExactProjectReferenceVersions)' != 'false'">
    <ItemGroup>
      <_GoExactProjectReference Include="@(_ProjectReferencesWithVersions)"
                                ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]"
                                Condition="!$([System.String]::Copy('%(_ProjectReferencesWithVersions.ProjectVersion)').StartsWith('['))" />
      <_ProjectReferencesWithVersions Remove="@(_GoExactProjectReference)" />
      <_ProjectReferencesWithVersions Include="@(_GoExactProjectReference)" />
    </ItemGroup>
  </Target>

  <!-- Before NuGet collects the package's files (_GetPackageFiles gathers every None with Pack=true). -->
  <Target Name="GoWritePackageUsingsProps"
          BeforeTargets="_GetPackageFiles"
          Condition="'$(Product)' == 'go2cs' and '$(GoPackageUsingsProps)' != 'false' and '$(PackageId)' != ''">
    <!-- One package_info.cs per package directory: the root copy, else the first per-GOOS copy. The
         per-GOOS folders are read only when the root has none, so a real subpackage that happens to be
         named for a GOOS (internal/syscall/windows) is never mistaken for a flavour folder of a package
         that has its own root copy. -->
    <ItemGroup>
      <_GoPackageDirectory Include="@(GoPackageDirectory->'%(FullPath)')" />
      <_GoPackageDirectory Include="$(MSBuildProjectDirectory)" Condition="'@(GoPackageDirectory)' == ''" />
      <_GoPackageInfo Include="%(_GoPackageDirectory.FullPath)/package_info.cs"
                      Condition="Exists('%(_GoPackageDirectory.FullPath)/package_info.cs')" />
      <_GoPackageInfo Include="%(_GoPackageDirectory.FullPath)/windows/package_info.cs"
                      Condition="!Exists('%(_GoPackageDirectory.FullPath)/package_info.cs') and Exists('%(_GoPackageDirectory.FullPath)/windows/package_info.cs')" />
      <_GoPackageInfo Include="%(_GoPackageDirectory.FullPath)/linux/package_info.cs"
                      Condition="!Exists('%(_GoPackageDirectory.FullPath)/package_info.cs') and !Exists('%(_GoPackageDirectory.FullPath)/windows/package_info.cs') and Exists('%(_GoPackageDirectory.FullPath)/linux/package_info.cs')" />
      <_GoPackageInfo Include="%(_GoPackageDirectory.FullPath)/darwin/package_info.cs"
                      Condition="!Exists('%(_GoPackageDirectory.FullPath)/package_info.cs') and !Exists('%(_GoPackageDirectory.FullPath)/windows/package_info.cs') and !Exists('%(_GoPackageDirectory.FullPath)/linux/package_info.cs') and Exists('%(_GoPackageDirectory.FullPath)/darwin/package_info.cs')" />
    </ItemGroup>

    <!-- The converter's package_info.cs declares `namespace <ns>;` and then
         `[GoPackage("<name>"...)] public static partial class <class>`. A namespace segment or class
         that is a C# keyword is written escaped (`go.@internal`), and is used as written. -->
    <ItemGroup>
      <_GoPackageInfo>
        <GoDeclared>$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '(?m)^namespace\s+[\w.@]+\s*;[\s\S]*?\[GoPackage\("\w+"[^\]]*\)\]\s*public\s+static\s+(?:unsafe\s+)?partial\s+class\s+@?\w+'))</GoDeclared>
      </_GoPackageInfo>
    </ItemGroup>
    <Error Condition="'@(_GoPackageInfo)' != '' and '%(_GoPackageInfo.GoDeclared)' != 'True'"
           Text="go.lib: %(_GoPackageInfo.FullPath) declares no namespace followed by a [GoPackage] package class, so build/$(PackageId).props cannot name the package's usings. Set GoPackageUsingsProps=false to pack without it." />
    <ItemGroup>
      <_GoPackageInfo>
        <GoNamespace>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(FullPath)')), '(?s)\A.*?(?m:^)namespace\s+([\w.@]+)\s*;.*\z', '$1'))</GoNamespace>
        <GoPackageName>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(FullPath)')), '(?s)\A.*?\[GoPackage\("(\w+)"[^\]]*\)\]\s*public\s+static\s+(?:unsafe\s+)?partial\s+class\s+@?\w+.*\z', '$1'))</GoPackageName>
        <GoPackageClass>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(FullPath)')), '(?s)\A.*?\[GoPackage\("\w+"[^\]]*\)\]\s*public\s+static\s+(?:unsafe\s+)?partial\s+class\s+(@?\w+).*\z', '$1'))</GoPackageClass>
      </_GoPackageInfo>
      <!-- The alias is the Go package name, escaped when it is a C# keyword (unsafe, internal). -->
      <_GoPackageInfo>
        <GoAlias>%(GoPackageName)</GoAlias>
        <GoAlias Condition="$([System.String]::Copy(';abstract;as;base;bool;break;byte;case;catch;char;checked;class;const;continue;decimal;default;delegate;do;double;else;enum;event;explicit;extern;false;finally;fixed;float;for;foreach;goto;if;implicit;in;int;interface;internal;is;lock;long;namespace;new;null;object;operator;out;override;params;private;protected;public;readonly;ref;return;sbyte;sealed;short;sizeof;stackalloc;static;string;struct;switch;this;throw;true;try;typeof;uint;ulong;unchecked;unsafe;ushort;using;virtual;void;volatile;while;').Contains(';%(GoPackageName);'))">@%(GoPackageName)</GoAlias>
      </_GoPackageInfo>
      <_GoNamespaceUsing Include="%(_GoPackageInfo.GoNamespace)" Condition="'%(_GoPackageInfo.GoNamespace)' != 'go'" />
    </ItemGroup>

    <!-- One string with escaped line breaks (%0A), so WriteLinesToFile keeps the indentation an item
         list would trim. %24 is a literal $: the consumer's properties, evaluated where the file is imported. -->
    <PropertyGroup>
      <_GoPackageUsingsProps>$(IntermediateOutputPath)go2cs-pack/$(PackageId).props</_GoPackageUsingsProps>
      <_GoNamespaceUsings>@(_GoNamespaceUsing->Distinct()->'    &lt;Using Include="%(Identity)" /&gt;', '%0A')</_GoNamespaceUsings>
      <_GoAliasUsings>@(_GoPackageInfo->'    &lt;Using Include="%(GoNamespace).%(GoPackageClass)" Alias="%(GoAlias)" /&gt;', '%0A')</_GoAliasUsings>
      <_GoPackageUsingsText>&lt;Project&gt;%0A  &lt;!-- Written by go.lib.pack.targets when $(PackageId) was packed: the package's usings (see that file in go.lib). --&gt;</_GoPackageUsingsText>
      <_GoPackageUsingsText Condition="'$(_GoNamespaceUsings)' != ''">$(_GoPackageUsingsText)%0A  &lt;ItemGroup Condition="'%24(GoConsumerUsings)' != 'false'"&gt;%0A$(_GoNamespaceUsings)%0A  &lt;/ItemGroup&gt;</_GoPackageUsingsText>
      <_GoPackageUsingsText>$(_GoPackageUsingsText)%0A  &lt;ItemGroup Condition="'%24(GoGlobalPackageAliases)' == 'true'"&gt;%0A$(_GoAliasUsings)%0A  &lt;/ItemGroup&gt;%0A&lt;/Project&gt;</_GoPackageUsingsText>
    </PropertyGroup>

    <WriteLinesToFile Condition="'@(_GoPackageInfo)' != ''" File="$(_GoPackageUsingsProps)" Lines="$(_GoPackageUsingsText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup Condition="'@(_GoPackageInfo)' != ''">
      <None Include="$(_GoPackageUsingsProps)" Pack="true" PackagePath="build/" Visible="false" />
      <FileWrites Include="$(_GoPackageUsingsProps)" />
    </ItemGroup>
  </Target>
</Project>

<Project>
  <!--
    go.lib.twins.targets - Gbtc
    Copyright © 2026 The go2cs Authors. All rights reserved.

    Use of this source code is governed by an MIT-style license
    that can be found in the LICENSE file.

    THE TWIN OPT-IN, FOR EVERY CONVERTED PROGRAM (docs/AsyncTwins.md, How to opt in).

    A project builds with twins (async twins for the M:N scheduler, generated by go2cs-gen's TwinGenerator) when it
    is named in GoTwinsFor. Until 2026-11-25 this switch lived only in the repository's src/Directory.Build.targets,
    so a program converted anywhere else built without twins and said nothing. Measured that day (R, COORD
    20261125T182108Z): a goroutine program converted outside the repository and built with GoTwinsFor, on the
    command line and in the environment, read 0 twins in all three runtime modes (local references against a
    clone, a deploy-core root, NuGet packages), and 4 with the repository's targets imported.

    ONE definition, three importers, as go.lib.symbols.targets: go.lib.targets (every NuGet consumer of a go.*
    package), the repository's src/Directory.Build.targets (every in-tree project) and the Directory.Build.targets
    that `go2cs -recurse` generates (a module conversion in local-reference mode). The guard property keeps a second
    import inert.

    What a consumer may set, and only that:
    - GoTwinsFor: the projects to build with twins, their project file names without .csproj, separated by ';'.
      GoTwinsForIface / GoTwinsForIfaceAll carry the interface shape to those projects only.
    - GoTwins=true in a project's own file (go2cs rewrites the project file on each conversion, so GoTwinsFor is the
      durable form).
    - GoTwinsSiblings, GoTwinsTiming, GoTwinsWeak and GoTwinsCut: they do not change which members get twins
      (src/Directory.Build.targets documents each).
    The prototype arms (GoTwinsArm and every switch it gates, GoTwinsGuardDrop, GoTwinsRefuse) stay in the
    repository's src/Directory.Build.targets: they are for go2cs's own measurements, and a switch the generator
    refuses without GoTwinsArm (GO2CS0018) has no consumer meaning.
  -->
  <PropertyGroup Condition="'$(GoLibTwinsTargetsImported)' != 'true'">
    <GoLibTwinsTargetsImported>true</GoLibTwinsTargetsImported>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GoTwinsFor)' != '' and $([System.String]::Copy(';$(GoTwinsFor);').Contains(';$(MSBuildProjectName);'))">
    <GoTwins>true</GoTwins>
    <GoTwinsIface Condition="'$(GoTwinsIface)' == ''">$(GoTwinsForIface)</GoTwinsIface>
    <GoTwinsIfaceAll Condition="'$(GoTwinsIfaceAll)' == ''">$(GoTwinsForIfaceAll)</GoTwinsIfaceAll>
  </PropertyGroup>

  <!-- The properties go2cs-gen reads (build_property.*): a property it cannot see is unset to it. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="GoTwins" />
    <CompilerVisibleProperty Include="GoTwinsIface" />
    <CompilerVisibleProperty Include="GoTwinsIfaceAll" />
    <CompilerVisibleProperty Include="GoTwinsSiblings" />
    <CompilerVisibleProperty Include="GoTwinsTiming" />
    <CompilerVisibleProperty Include="GoTwinsWeak" />
    <CompilerVisibleProperty Include="GoTwinsCut" />
  </ItemGroup>

  <!-- A twinned executable starts through go2cs-gen's GoTwinEntry, which runs main's twin. -->
  <PropertyGroup Condition="'$(GoTwins)' == 'true' and '$(OutputType)' == 'Exe'">
    <StartupObject>go.GoTwinEntry</StartupObject>
  </PropertyGroup>
</Project>

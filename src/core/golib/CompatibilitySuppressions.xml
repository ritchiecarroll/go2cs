<!--
  golib's ANNOUNCED binary breaks, read by the release's binary-compatibility guard
  (src/tools/pushnuget/GoApiCompat.psm1; docs/phase4/DESIGN-binary-compat-guard.md).

  Every entry is B3 (batch 231): a foreach over a slice or array yields VALUES; range(s) yields (index, value)
  pairs and range(len(s)) yields indexes. The 1.26.10.3 release notes announce it under "Upgrading", the
  nugetgo rebuild wave ships with that release, and the 1.26.10.2 module revisions are deprecated.

  Baseline: the published go.lib 1.26.10.2. Each entry names golib's asset on both sides (assembly mode, one
  asset at a time). When 1.26.10.3 is published it becomes the baseline, every entry here matches nothing, and
  the guard reads each one RED as unnecessary: delete this file then. A suppression never outlives the release
  that announced it.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- B3, batch 231: sslice<T>.Enumerator, which yielded (nint, T), is gone: GetEnumerator returns Span<T>.Enumerator, so a foreach yields values -->
  <Suppression>
    <DiagnosticId>CP0001</DiagnosticId>
    <Target>T:go.sslice`1.Enumerator</Target>
    <Left>lib/net10.0/golib.dll</Left>
    <Right>lib/net10.0/golib.dll</Right>
  </Suppression>
  <!-- B3, batch 231: array<T>.Enumerator.Current returned (nint, T); it returns T -->
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:go.array`1.Enumerator.get_Current</Target>
    <Left>lib/net10.0/golib.dll</Left>
    <Right>lib/net10.0/golib.dll</Right>
  </Suppression>
  <!-- B3, batch 231: builtin.range over this operand returned the index range (RangeOverInt<nint>); range(s) yields (index, value) pairs now, and range(len(s)) the indexes -->
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:go.builtin.range``1(``0@)</Target>
    <Left>lib/net10.0/golib.dll</Left>
    <Right>lib/net10.0/golib.dll</Right>
  </Suppression>
  <!-- B3, batch 231: builtin.range over this operand returned the index range (RangeOverInt<nint>); range(s) yields (index, value) pairs now, and range(len(s)) the indexes -->
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:go.builtin.range``1(go.array{``0})</Target>
    <Left>lib/net10.0/golib.dll</Left>
    <Right>lib/net10.0/golib.dll</Right>
  </Suppression>
  <!-- B3, batch 231: builtin.range over this operand returned the index range (RangeOverInt<nint>); range(s) yields (index, value) pairs now, and range(len(s)) the indexes -->
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:go.builtin.range``1(go.slice{``0})</Target>
    <Left>lib/net10.0/golib.dll</Left>

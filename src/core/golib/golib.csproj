<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shared NuGet version stamp (src/version.props) arrives via src/core/Directory.Build.props;
       a direct import here would double-import it (MSB4011). Deployed trees exclude that props file
       and never pack, so golib needs no version stamp there. -->

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)'==''">net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>go</RootNamespace>
    <AssemblyName>golib</AssemblyName>
    <Product>go2cs</Product>
    <Description>Go core library functions in .NET for use with go2cs: $(AssemblyName) ($(TargetFramework) - $(Configuration))</Description>
    <AssemblyTitle>$(Description)</AssemblyTitle>
    <Authors>$(Product) Authors</Authors>
    <Company>The $(Authors)</Company>
    <Copyright>Copyright © 2018-2026 $(Company)</Copyright>
    <RepositoryUrl>https://github.com/ritchiecarroll/go2cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>../go2cs.ico</ApplicationIcon>
    <Title>go2cs core library</Title>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>go.lib</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageDescription>$(Description)</PackageDescription>
    <PackageProjectUrl>https://github.com/ritchiecarroll/go2cs</PackageProjectUrl>
    <PackageIcon>go2cs.png</PackageIcon>
    <PackageTags>go2cs;Golang;go</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <!-- golib is HAND-written and deliberately does NOT inherit the corpus suppression list: it is
         the reflection/unsafe core, so its trim (IL####) and nullable warnings are a real to-do list
         with an owner, not emission noise. Only CS8500 is a policy entry — the unsafe machinery lives
         here on purpose — and the corpus must not inherit it. 1701/1702 were .NET Framework
         assembly-binding redirects that cannot fire on net10.0; 660/661 were bare numbers. -->
    <NoWarn>CS0660;CS0661;CS8500;CS8981;IDE1006;CA2255</NoWarn>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OutDir)'==''">
    <OutDir>bin/$(Configuration)/$(TargetFramework)/</OutDir>
  </PropertyGroup>

  <!-- USERPROFILE is a Windows-only environment variable; HOME is its POSIX counterpart. Every
       CONVERTED project inherits this fallback from csproj-template.xml, but golib.csproj is
       hand-written and never regenerated, so it was the one project in the tree without it: a
       non-Debug build outside a solution context resolves $(go2csPath) to "/go2cs/" on Linux and
       macOS (F10, docs/PLAN-linux-operation.md). Kept in the template's exact form. -->
  <PropertyGroup Condition="'$(USERPROFILE)'==''">
    <USERPROFILE>$(HOME)</USERPROFILE>
  </PropertyGroup>

  <PropertyGroup Condition="'$(go2csPath)'==''">
    <go2csPath Condition="'$(Configuration)'!='Debug'">$(USERPROFILE)/go2cs/</go2csPath>
    <go2csPath Condition="'$(Configuration)'=='Debug'">$(SolutionDir)</go2csPath>
  </PropertyGroup>

  <!-- Enable native compiled output optimizations -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>True</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../go2cs.ico" Pack="true" PackagePath="" Visible="false" />
    <None Include="../go2cs.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="go.builtin" Static="True" />
    <Using Include="System" />
    <Using Include="System.Numerics" />
    <Using Include="System.Object" Alias="any" />
    <Using Include="System.Byte" Alias="uint8" />
    <Using Include="System.UInt16" Alias="uint16" />
    <Using Include="System.UInt32" Alias="uint32" />
    <Using Include="System.UInt64" Alias="uint64" />
    <Using Include="System.SByte" Alias="int8" />
    <Using Include="System.Int16" Alias="int16" />
    <Using Include="System.Int32" Alias="int32" />
    <Using Include="System.Int64" Alias="int64" />
    <Using Include="System.Single" Alias="float32" />
    <Using Include="System.Double" Alias="float64" />
    <Using Include="System.Numerics.Complex" Alias="complex128" />
    <Using Include="System.Int32" Alias="rune" />
    <Using Include="System.Numerics.BigInteger" Alias="GoBigConst" />
    <Using Include="System.ComponentModel.DescriptionAttribute" Alias="GoTagAttribute" />
    <Using Include="System.Runtime.CompilerServices.ModuleInitializerAttribute" Alias="GoInitAttribute" />
  </ItemGroup>

  <!-- golib declares NO package dependencies. The one it used to carry is worth a note so it is
       not reflexively restored: Microsoft.CSharp 4.7.0 supplies the runtime binder behind the C#
       `dynamic` keyword, and golib uses `dynamic` nowhere — every occurrence of the word in this
       library is prose in a doc comment, where it means a GO dynamic value (go2cs's own term),
       not the C# feature. The compiler agreed: golib.dll carried no Microsoft.CSharp assembly
       reference even while the PackageReference was declared. It was redundant regardless, the
       assembly being part of the shared framework on .NET Core 3.0+. Its only real effect was to
       propagate a spurious dependency into the published go.lib package — and from there into
       every converted package in the corpus, all of which depend on go.lib. -->

  <!-- Deliberately keeps BACKSLASHES where the rest of this file moved to forward slashes (F5):
       this is Visual Studio's shared-project bookkeeping, not a converter-emitted reference. VS
       owns the Import's exact text and go2cs-gen.csproj carries the identical backslash form, so
       re-spelling it here would buy nothing and risk perpetual VS round-trip drift. MSBuild
       normalizes it on Unix regardless, so it is not a portability seam. -->
  <Import Project="..\go2cs\go2cs.projitems" Label="Shared" />

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/LICENSE')" />
    <None Include="NOTICE" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/NOTICE')" />
    <None Include="AUTHORS" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)/AUTHORS')" />
  </ItemGroup>
</Project>

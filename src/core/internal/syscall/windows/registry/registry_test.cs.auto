internal static void testGetValue(ж<testing.T> t, registry.Key k, ValueTest test, nint size) {
    if (size <= 0) {
        return;
    }
    // read data with no buffer
    var (gotsize, gottype, err) = k.GetValue(test.Name, default);
    if (err != nil) {
        t.Errorf("GetValue(%s, [%d]byte) failed: %v", test.Name, size, err);
        return;
    }
    if (gotsize != size) {
        t.Errorf("want %s value size of %d, got %v", test.Name, size, gotsize);
        return;
    }
    if (gottype != test.Type) {
        t.Errorf("want %s value type %v, got %v", test.Name, test.Type, gottype);
        return;
    }
    // read data with short buffer
    (gotsize, gottype, err) = k.GetValue(test.Name, new slice<byte>(size - 1));
    if (err == nil) {
        t.Errorf("GetValue(%s, [%d]byte) should fail, but succeeded", test.Name, size - 1);
        return;
    }
    if (!AreEqual(err, registry.ErrShortBuffer)) {
        t.Errorf("reading %s value should return 'short buffer' error, but got: %s", test.Name, err);
        return;
    }
    if (gotsize != size) {
        t.Errorf("want %s value size of %d, got %v", test.Name, size, gotsize);
        return;
    }
    if (gottype != test.Type) {
        t.Errorf("want %s value type %v, got %v", test.Name, test.Type, gottype);
        return;
    }
    // read full data
    (gotsize, gottype, err) = k.GetValue(test.Name, new slice<byte>(size));
    if (err != nil) {
        t.Errorf("GetValue(%s, [%d]byte) failed: %v", test.Name, size, err);
        return;
    }
    if (gotsize != size) {
        t.Errorf("want %s value size of %d, got %v", test.Name, size, gotsize);
        return;
    }
    if (gottype != test.Type) {
        t.Errorf("want %s value type %v, got %v", test.Name, test.Type, gottype);
        return;
    }
    // check GetValue returns ErrNotExist as required
    (_, _, err) = k.GetValue(test.Name + "_not_there"u8, new slice<byte>(size));
    if (err == nil) {
        t.Errorf("GetValue(%q) should not succeed", test.Name);
        return;
    }
    if (!AreEqual(err, registry.ErrNotExist)) {
        t.Errorf("GetValue(%q) should return 'not exist' error, but got: %s", test.Name, err);
        return;
    }
}

internal static void testValues(ж<testing.T> t, registry.Key k) {
    foreach (var (_, test) in range(ValueTests)) {
        switch (test.Type) {
        case var ᴛ when ᴛ == registry.SZ || ᴛ == registry.EXPAND_SZ: {
            if (test.WillFail) {
                var (_, _, errΔ3) = k.GetStringValue(test.Name);
                testErrNotExist(t, test.Name, errΔ3);
            } else {
                testGetStringValue(t, k, test);
                var (_, gottype, errΔ4) = k.GetIntegerValue(test.Name);
                testErrUnexpectedType(t, test, gottype, errΔ4);
                // Size of utf16 string in bytes is not perfect,
                // but correct for current test values.
                // Size also includes terminating 0.
                testGetValue(t, k, test, (len(test.Value._<@string>()) + 1) * 2);
            }
            var (_, _, err) = k.GetStringValue(test.Name + "_string_not_created"u8);
            testErrNotExist(t, test.Name + "_string_not_created"u8, err);
            break;
        }
        case var ᴛ when ᴛ == registry.DWORD || ᴛ == registry.QWORD: {
            testGetIntegerValue(t, k, test);
            var (_, gottype, err) = k.GetBinaryValue(test.Name);
            testErrUnexpectedType(t, test, gottype, err);
            (_, _, err) = k.GetIntegerValue(test.Name + "_int_not_created"u8);
            testErrNotExist(t, test.Name + "_int_not_created"u8, err);
            nint size = 8;
            if (test.Type == registry.DWORD) {
                size = 4;
            }
            testGetValue(t, k, test, size);
            break;
        }
        case var ᴛ when ᴛ == registry.BINARY: {
            testGetBinaryValue(t, k, test);
            var (_, gottype, err) = k.GetStringsValue(test.Name);
            testErrUnexpectedType(t, test, gottype, err);
            (_, _, err) = k.GetBinaryValue(test.Name + "_byte_not_created"u8);
            testErrNotExist(t, test.Name + "_byte_not_created"u8, err);
            testGetValue(t, k, test, len(test.Value._<slice<byte>>()));
            break;
        }
        case var ᴛ when ᴛ == registry.MULTI_SZ: {
            if (test.WillFail) {
                var (_, _, errΔ1) = k.GetStringsValue(test.Name);
                testErrNotExist(t, test.Name, errΔ1);
            } else {
                testGetStringsValue(t, k, test);
                var (_, gottype, errΔ2) = k.GetStringValue(test.Name);
                testErrUnexpectedType(t, test, gottype, errΔ2);
                nint size = 0;
                foreach (var (_, s) in range(test.Value._<slice<@string>>())) {
                    size += len(s) + 1; // nil terminated
                }
                size += 1; // extra nil at the end
                size *= 2; // count bytes, not uint16
                testGetValue(t, k, test, size);
            }
            var (_, _, err) = k.GetStringsValue(test.Name + "_strings_not_created"u8);
            testErrNotExist(t, test.Name + "_strings_not_created"u8, err);
            break;
        }
        default: {
            t.Errorf("unsupported type %d for %s value", test.Type, test.Name);
            continue;
            break;
        }}
    }
}


internal static void testStat(ж<testing.T> t, registry.Key k) {
    GoFrame ᒐ = default;
    try {
        var (subk, _, err) = registry.CreateKey(k, subkeyˢ, registry.CREATE_SUB_KEY);
        if (err != nil) {
            t.Error(err);
            return;
        }
        defer(() => subk.Close(), ref ᒐ);

        defer(registry.DeleteKey, k, subkeyˢ, ref ᒐ);

        (var ki, err) = k.Stat();
        if (err != nil) {
            t.Error(err);
            return;
        }
        if (ki.SubKeyCount != 1) {
            t.Error(keyMustHave1Subkeyˢ);
        }
        if (ki.MaxSubKeyLen != 6) {
            t.Error(keyMaxSubkeyNameLengthˢ);
        }
        if (ki.ValueCount != 24) {
            t.Errorf("key must have 24 values, but is %d", ki.ValueCount);
        }
        if (ki.MaxValueNameLen != 12) {
            t.Errorf("key max value name length must be 10, but is %d", ki.MaxValueNameLen);
        }
        if (ki.MaxValueLen != 38) {
            t.Errorf("key max value length must be 38, but is %d", ki.MaxValueLen);
        }
    }
    catch (Exception ᒐex) when (GoFrame.IsPanic(ᒐex, out PanicException? ᒐp)) { GoFrame.Capture(ᒐp); }
    finally { ᒐ.Run(); }
}

internal static void deleteValues(ж<testing.T> t, registry.Key k) {

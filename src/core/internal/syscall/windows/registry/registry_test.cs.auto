            t.Error(errΔ1);
            continue;
        }
    }
    var (names, err) = k.ReadValueNames();
    if (err != nil) {
        t.Error(err);
        return;
    }
    if (len(names) != 0) {
        t.Errorf("some values remain after deletion: %v", names);
    }
}


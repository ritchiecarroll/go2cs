-- csproj examples:
   archive\tar\archive.tar.csproj insert
     - 
     +     <!-- Count calls from the start: .NET otherwise waits until about 100 ms pass with no new method compiled, so a short
     +          busy phase runs the standard library's small functions unoptimized. Another value is a delay in milliseconds;
     +          `runtime` keeps .NET's own default. https://github.com/ritchiecarroll/go2cs/blob/master/docs/Tuning.md -->
   archive\tar\archive.tar.csproj insert
     - 
     + 
     +   <ItemGroup Condition="'$(OutputType)'!='Library' AND '$(GoCallCountingDelayMs)'!='runtime'">
     +     <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="$(GoCallCountingDelayMs)" />
